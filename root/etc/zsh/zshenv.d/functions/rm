#[what] shadow rm with trash; drop flags, forward paths only
#[why] trash is recoverable, rm unlinks irreversibly
#[where] $ man trash

function rm {
  emulate -LR zsh

  local -a paths
  local arg
  for arg in "$@"; do
    [[ $arg == -* ]] && continue  #[what] drop flags
    paths+=("$arg")
  done

  trash "${paths[@]}"
}
