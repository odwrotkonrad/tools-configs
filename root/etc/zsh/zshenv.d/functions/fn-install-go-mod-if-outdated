#[what] fn-install-go-mod-if-outdated <bin> <module@version>: go install when the on-PATH bin is absent or its embedded module version differs from the pin
#[why] published tools must pick up version bumps even when a stale binary is on PATH
#[why] CGO_ENABLED=1 + CC=clang: che pulls onepassword-sdk-go, which needs cgo to build; install into GOPATH/bin (no sudo)

function fn-install-go-mod-if-outdated {
  emulate -LR zsh
  autoload -Uz fn-log-msg
  local bin=$1 module=$2
  local want=${module##*@} have

  if (( $+commands[$bin] )) {
    have=$(go version -m $commands[$bin] 2>/dev/null | awk '$1 == "mod" { print $3; exit }')
    if [[ -n $have && $have == $want ]] {
      fn-log-msg -t $bin -- "already installed ($have)"
      return
    }
    fn-log-msg -t $bin -- "reinstalling ${have:-unknown} -> $want"
  } else {
    fn-log-msg -t $bin -- "installing $want"
  }

  CGO_ENABLED=1 CC=clang go install $module
  fn-log-msg -t $bin -- installed
}
