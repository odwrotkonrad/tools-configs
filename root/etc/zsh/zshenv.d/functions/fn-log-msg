#[what] log a line as '[title: ]msg', title via optional -t/--title
#   title formats as type(subtype): type bold, '(subtype)' plain

function fn-log-msg {
  emulate -LR zsh
  setopt errexit pipefail
  autoload -Uz fn-print-with

  local -a title
  zparseopts -D t:=title -title:=title

  local prefix=""
  if (( ${#title} )) {
    local type=${title[2]%%\(*} sub=${title[2]#${title[2]%%\(*}}
    prefix="$(fn-print-with bold $type)$sub: "
  }

  print -- "$prefix$*"
}
