#[≟] export a service's secrets into the shell via s_auth

emulate -LR zsh

if [[ -z $1 ]]; then
  print -u2 "fn_auth: usage: fn_auth <service> [container] [field]"
  return 2
fi

local out
out=$(${AUTH_SCRIPT:-/usr/local/scripts_py/s_auth} "$@") || return $?

local line
for line in ${(f)out}; do
  if [[ $line == *=* ]]; then
    export $line
    print "fn_auth: exported ${line%%=*}"
  fi
done
