emulate -LR zsh

local service=$1
local etc_config=${AUTH_ETC_CONFIG:-/etc/custom/secrets.yml}
local user_config=${XDG_CONFIG_HOME:-$HOME/.config}/custom/secrets.yml

if [[ -z $service ]]; then
  print -u2 "fn_auth: usage: fn_auth <service>"
  return 2
fi

local -a configs=("$etc_config"(N) "$user_config"(N))
if (( ! ${#configs} )); then
  print -u2 "fn_auth: no config in $etc_config or $user_config"
  return 1
fi

#[≟] merge configs, apply defaults, emit "var op://vault/secret/field"
local line
line=$(SVC=$service yq eval-all '
  . as $i ireduce ({}; . * $i) |
  (.defaults // {}) as $d | (.services[strenv(SVC)] // {}) as $s | $d * $s |
  select(.variable) |
  .variable + " op://" + .vault + "/" + .secret + "/" + .secret_from_field
' "${configs[@]}")

if [[ -z $line ]]; then
  print -u2 "fn_auth: unknown service '$service'"
  return 2
fi

local var ref value
read -r var ref <<< "$line"

value=$(op read "$ref") || {
  print -u2 "fn_auth: failed to read '$ref'"
  return 1
}

export $var=$value
print "fn_auth: exported $var for $service"
