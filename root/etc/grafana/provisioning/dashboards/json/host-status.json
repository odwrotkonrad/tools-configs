    },
    {
      "id": 50,
      "type": "row",
      "title": "Network",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Network Traffic",
      "description": "Bytes received vs transmitted per time bucket (transmit drawn below zero).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "IN",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(system_network_io_bytes_total{direction=\"receive\"}[2m]))",
          "legendFormat": "In",
          "interval": "2m"
        },
        {
          "refId": "OUT",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(system_network_io_bytes_total{direction=\"transmit\"}[2m]))",
          "legendFormat": "Out",
          "interval": "2m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisCenteredZero": false,
            "gradientMode": "hue",
            "axisSoftMin": 0,
            "barWidthFactor": 0.9,
            "barMaxWidth": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "In"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8ab4f8"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 95
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Out"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#33415c"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 70
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    }
  ],
  "description": "Local observability stack \u2014 service health, host resources, network, and endpoint reference."
}