{
  "uid": "host-status",
  "title": "Host Status",
  "tags": [
    "observability",
    "host",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 16,
      "type": "table",
      "title": "Service Status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "LIVE",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(max by (app) (up), \"rank\",\"0\",\"app\",\"otelcol\"), \"rank\",\"1\",\"app\",\"prometheus\"), \"rank\",\"2\",\"app\",\"grafana\"), \"rank\",\"3\",\"app\",\"loki\"), \"rank\",\"4\",\"app\",\"jaeger\"), \"rank\",\"5\",\"app\",\"port_exporter\"), \"rank\",\"6\",\"app\",\"dir_size_exporter\")",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "UPTIME",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(min by (app) ((time() - max by (app) (process_start_time_seconds)) or (max by (app) (otelcol_process_uptime)) or (time() - max_over_time(timestamp(up == 0)[30d:30s])) or (time() - min_over_time(timestamp(up)[30d:30s]))) and on (app) (max by (app) (up) == 1), \"rank\",\"0\",\"app\",\"otelcol\"), \"rank\",\"1\",\"app\",\"prometheus\"), \"rank\",\"2\",\"app\",\"grafana\"), \"rank\",\"3\",\"app\",\"loki\"), \"rank\",\"4\",\"app\",\"jaeger\"), \"rank\",\"5\",\"app\",\"port_exporter\"), \"rank\",\"6\",\"app\",\"dir_size_exporter\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "rank",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "rank": true
            },
            "indexByName": {
              "app": 0,
              "Value #UPTIME": 1,
              "Value #LIVE": 2
            },
            "renameByName": {
              "app": "Service",
              "Value #LIVE": "Live",
              "Value #UPTIME": "Uptime"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Live",
                "destinationType": "boolean"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dthms"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Live"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 50
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "✓",
                        "color": "#7d6fc9",
                        "index": 0
                      },
                      "false": {
                        "text": "✗",
                        "color": "#2a2150",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
