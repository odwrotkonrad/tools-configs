{
  "uid": "host-status",
  "title": "Host Status",
  "tags": [
    "observability",
    "host",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "table",
      "title": "Services",
      "description": "Per-service health. Uptime = time since last seen down, or since the service first appeared if never down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(min by (app) ((time() - max_over_time(timestamp(up == 0)[30d:30s])) or (time() - min_over_time(timestamp(up)[30d:30s])))) and on (app) (max by (app) (up))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (app) (up)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "S0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(max by (app) (up), \"ui\",\"http://localhost:9090/\",\"app\",\"prometheus\"), \"ui\",\"http://localhost:9300/\",\"app\",\"grafana\"), \"ui\",\"http://localhost:3100/ready\",\"app\",\"loki\"), \"ui\",\"http://localhost:55679/debug/servicez\",\"app\",\"otelcol\"), \"ui\",\"http://localhost:16686/\",\"app\",\"jaeger\")",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "S1",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(max by (app) (up), \"metrics\",\"http://localhost:9090/metrics\",\"app\",\"prometheus\"), \"metrics\",\"http://localhost:9300/metrics\",\"app\",\"grafana\"), \"metrics\",\"http://localhost:3100/metrics\",\"app\",\"loki\"), \"metrics\",\"http://localhost:8889/metrics\",\"app\",\"otelcol\"), \"metrics\",\"http://localhost:8890/metrics\",\"app\",\"jaeger\")",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "S2",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(max by (app) (up), \"health\",\"http://localhost:9090/-/healthy\",\"app\",\"prometheus\"), \"health\",\"http://localhost:9300/api/health\",\"app\",\"grafana\"), \"health\",\"http://localhost:3100/ready\",\"app\",\"loki\"), \"health\",\"http://localhost:13133/\",\"app\",\"otelcol\"), \"health\",\"http://localhost:13134/\",\"app\",\"jaeger\")",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "S3",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(max by (app) (up), \"api\",\"http://localhost:9090/api/v1/query\",\"app\",\"prometheus\"), \"api\",\"http://localhost:3100/loki/api/v1/push\",\"app\",\"loki\"), \"api\",\"http://localhost:16686/search\",\"app\",\"jaeger\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #S0": true,
              "Value #S1": true,
              "Value #S2": true,
              "Value #S3": true
            },
            "indexByName": {
              "app": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "app": "Service",
              "Value #A": "Uptime",
              "Value #B": "UP"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "UI",
                    "url": "${__data.fields.ui}",
                    "targetBlank": true
                  },
                  {
                    "title": "Metrics",
                    "url": "${__data.fields.metrics}",
                    "targetBlank": true
                  },
                  {
                    "title": "Health",
                    "url": "${__data.fields.health}",
                    "targetBlank": true
                  },
                  {
                    "title": "API",
                    "url": "${__data.fields.api}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dthms"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "UP"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ui"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "metrics"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "health"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "api"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "Mean CPU utilization across all cores (1 - idle).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - avg(system_cpu_utilization_ratio{state=\"idle\"})",
          "legendFormat": "CPU busy"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory Used",
      "description": "Used physical memory. Axis max is total RAM (~17 GB).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "system_memory_usage_bytes{state=\"used\"}",
          "legendFormat": "Used"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0,
          "max": 17179869184,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            },
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.92
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Disk Usage",
      "description": "Used space on the root APFS volume over the last month. Axis max is total capacity (~494 GB).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "system_filesystem_usage_bytes{mountpoint=\"/\",state=\"used\"}",
          "legendFormat": "Used"
        }
      ],
      "transformations": [],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0,
          "max": 494384795648,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Processes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 60,
      "type": "table",
      "title": "Top Processes by Memory (15m avg)",
      "description": "Top 10 by mean memory over the last 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, avg_over_time(max by (process_pid, process_executable_name) (process_memory_usage_bytes)[15m:]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "process_pid": 0,
              "process_executable_name": 1,
              "Value": 2
            },
            "renameByName": {
              "process_pid": "PID",
              "process_executable_name": "Name",
              "Value": "Memory"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "Memory",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decbytes"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 61,
      "type": "table",
      "title": "Top Processes by CPU (15m avg)",
      "description": "Top 10 by mean CPU over the last 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, avg_over_time(max by (process_pid, process_executable_name) (process_cpu_utilization_ratio)[15m:]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "process_pid": 0,
              "process_executable_name": 1,
              "Value": 2
            },
            "renameByName": {
              "process_pid": "PID",
              "process_executable_name": "Name",
              "Value": "CPU"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "CPU",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PID"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
