    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(5, avg_over_time(sum by (process_executable_name) (process_cpu_utilization_ratio)[1m:]))",
          "legendFormat": "{{process_executable_name}}",
          "interval": "1m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg_over_time(sum(process_cpu_utilization_ratio)[1m:]) - avg_over_time(sum(topk(5, sum by (process_executable_name) (process_cpu_utilization_ratio)))[1m:])",
          "legendFormat": "other",
          "interval": "1m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 85,
            "showPoints": "never",
            "gradientMode": "none",
            "axisBorderShow": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^[a-cA-C].*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8ab4f8" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^[d-gD-G].*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#9d7bff" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^[h-mH-M].*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#5a78c8" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^[n-rN-R].*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c4b5fd" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^[s-zS-Z0-9].*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#6d5fb8" } }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "other"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a2150"
                }
              }
            ]
          }
        ]
      }
    },
