    {
      "id": 11,
      "type": "table",
      "title": "Recent che Runs",
      "description": "Per-run ledger keyed by che_run_id (a YYYYMMDDThhmmss timestamp) — command, created/updated/noop mutations, and total operations, newest first.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "cmd",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (che_run_id, che_command) (last_over_time(che_command_runs_total{service_name=\"che\", command=~\"$command\"}[$__range]))",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "created",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (che_run_id) (last_over_time(che_unit_total{service_name=\"che\", command=~\"$command\", op_type=\"create\"}[$__range]))",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "updated",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (che_run_id) (last_over_time(che_unit_total{service_name=\"che\", command=~\"$command\", op_type=\"update\"}[$__range]))",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "noop",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (che_run_id) (last_over_time(che_unit_total{service_name=\"che\", command=~\"$command\", op_type=\"noop\"}[$__range]))",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "ops",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (che_run_id) (last_over_time(che_operation_runs_total{service_name=\"che\", che_command=~\"$command\"}[$__range]))",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "errors",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (che_run_id) (last_over_time(che_errors_total{service_name=\"che\"}[$__range]))",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "indexByName": {
              "che_run_id": 0,
              "che_command": 1,
              "Value #created": 2,
              "Value #updated": 3,
              "Value #noop": 4,
              "Value #errors": 5,
              "Value #ops": 6,
              "Value #cmd": 7
            },
            "renameByName": {
