    {
      "id": 12,
      "type": "stat",
      "title": "Errors",
      "description": "Failed operations (che_errors_total) in range — a run continues past a failing op, so this counts each op that returned an error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(che_errors_total{service_name=\"che\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#2f8f4e"
              },
              {
                "value": 1,
                "color": "#d64545"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Noop Ratio",
      "description": "Share of mutations that were no-ops — high means idempotent/stable, low means active drift being corrected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(last_over_time(che_unit_total{service_name=\"che\", command=~\"$command\", op_type=\"noop\"}[$__range])) / sum(last_over_time(che_unit_total{service_name=\"che\", command=~\"$command\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "0",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "continuous-BlPu"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "transparent"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Mutations by Kind",
      "description": "Total mutations grouped by target kind (link, dir, render, copy, …).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (last_over_time(che_unit_total{service_name=\"che\", command=~\"$command\"}[$__range]))",
          "legendFormat": "{{kind}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "text",
        "minVizWidth": 0,
        "maxVizHeight": 30,
        "namePlacement": "left",
        "sizing": "manual",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Mutations by Kind × Op Type",
      "description": "Mutations broken down by kind and op_type (create/update/noop), stacked bars.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind, op_type) (last_over_time(che_unit_total{service_name=\"che\", command=~\"$command\"}[$__range]))",
          "legendFormat": "{{kind}} / {{op_type}}",
          "instant": true
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7d6fc9"
          },
          "custom": {
            "fillOpacity": 90,
            "gradientMode": "hue",
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "barAlignment": 0,
            "barMaxWidth": 60,
            "barWidthFactor": 0.9,
            "lineWidth": 0,
            "axisBorderShow": false,
            "axisGridShow": true,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[a-eA-E0-9].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c4b5fd"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[f-jF-J].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8ab4f8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[k-oK-O].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9d7bff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[p-tP-T].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6d5fb8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[u-zU-Z].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4c4789"
                }
              }
            ]
          }
        ]
      }
    },
