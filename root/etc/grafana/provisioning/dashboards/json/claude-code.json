            "uid": "prometheus"
          },
          "expr": "label_join(sum by (project, session_id, model) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", model=~\"$model\", type=\"cacheCreation\"}[$__range])) and on (project, session_id, model) (sum by (project, session_id, model) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", model=~\"$model\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\", \"model\")",
