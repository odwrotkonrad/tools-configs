{
  "uid": "claude-code",
  "title": "Claude Code",
  "version": 1,
  "tags": [
    "claude-code",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_session_count_total, project)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "session_id",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 3,
          "query": "query_result(sum by (session_id) (increase(claude_code_cost_usage_USD_total[$__range])) > 0)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/session_id=\"([^\"]+)\"/",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Tokens, Cache, Lines Of Code",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 11,
      "description": "Per-session token, cache, line-of-code and cost totals for the selected range.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "right",
            "filterable": false
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Lines Added"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Lines Removed"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(InPlusCache|Denom|EffRaw|EffScaled|EffFloored)$"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache Efficiency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "min",
                "value": 0.9
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Project"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Session"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "custom.width",
                "value": 330
              },
              {
                "id": "custom.filterable",
                "value": false
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Cost (USD)",
            "desc": true
          }
        ],
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Tokens In",
            "Tokens Out",
            "Cache Read",
            "Cache Create",
            "Tokens",
            "Lines Added",
            "Lines Removed",
            "Cost (USD)"
          ]
        }
      },
      "targets": [
        {
          "refId": "in",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", type=\"input\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "out",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", type=\"output\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "cacheRead",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", type=\"cacheRead\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "cacheCreate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", type=\"cacheCreation\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "total",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "linesAdded",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join((sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0)) * 0 + on (project, session_id) group_left sum by (project, session_id) (increase(claude_code_lines_of_code_count_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", type=\"added\"}[$__range])), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "linesRemoved",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join((sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0)) * 0 + on (project, session_id) group_left sum by (project, session_id) (increase(claude_code_lines_of_code_count_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", type=\"removed\"}[$__range])), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "cost",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join(sum by (project, session_id) (increase(claude_code_cost_usage_USD_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) and on (project, session_id) (sum by (project, session_id) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\")",
          "instant": true,
          "format": "table",
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "pms",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "pms": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "project 2": true,
              "project 3": true,
              "project 4": true,
              "session_id 2": true,
              "session_id 3": true,
              "session_id 4": true,
              "project 5": true,
              "session_id 5": true,
              "project 6": true,
              "session_id 6": true,
              "project 7": true,
              "session_id 7": true,
              "project 8": true,
              "session_id 8": true
            },
            "indexByName": {
              "project 1": 0,
              "session_id 1": 1,
              "Value #in": 3,
              "Value #out": 4,
              "Value #cacheRead": 5,
              "Value #cacheCreate": 6,
              "Value #total": 7,
              "Value #linesAdded": 8,
              "Value #linesRemoved": 9,
              "Value #cost": 10
            },
            "renameByName": {
              "project 1": "Project",
              "session_id 1": "Session",
              "Value #in": "Tokens In",
              "Value #out": "Tokens Out",
              "Value #cacheRead": "Cache Read",
              "Value #cacheCreate": "Cache Create",
              "Value #total": "Tokens",
              "Value #linesAdded": "Lines Added",
              "Value #linesRemoved": "Lines Removed",
              "Value #cost": "Cost (USD)"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "InPlusCache",
            "mode": "binary",
            "binary": {
              "left": "Tokens In",
              "operator": "+",
              "right": "Cache Read"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Denom",
            "mode": "binary",
            "binary": {
              "left": "InPlusCache",
              "operator": "+",
              "right": "Cache Create"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "EffRaw",
            "mode": "binary",
            "binary": {
              "left": "Cache Read",
              "operator": "/",
              "right": "Denom"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "EffScaled",
            "mode": "binary",
            "binary": {
              "left": "EffRaw",
              "operator": "*",
              "right": "100000"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "EffFloored",
            "mode": "unary",
            "unary": {
              "operator": "floor",
              "fieldName": "EffScaled"
            },
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Cache Efficiency",
            "mode": "binary",
            "binary": {
              "left": "EffFloored",
              "operator": "/",
              "right": "100000"
            },
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Project": 0,
              "Session": 1,
              "Tokens": 2,
              "Tokens In": 3,
              "Tokens Out": 4,
              "Cache Read": 5,
              "Cache Create": 6,
              "Lines Added": 7,
              "Lines Removed": 8,
              "Cache Efficiency": 9,
              "Cost (USD)": 10
            },
            "renameByName": {}
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Shell Command Count",
      "description": "Bash command invocations over time, stacked by command, in 5-minute buckets.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 213,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#7d6fc9"
          },
          "custom": {
            "fillOpacity": 100,
            "gradientMode": "none",
            "stacking": {
              "mode": "normal"
            },
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 1,
            "axisBorderShow": false,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[a-eA-E0-9].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e3e7f5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[f-jF-J].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#a9b4e0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[k-oK-O].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9d7bff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[p-tP-T].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#4c4789"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^[u-zU-Z].*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#241d4d"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false,
          "placement": "bottom",
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (command) (count_over_time({service_name=\"claude-code\"} | event_name=\"tool_decision\" | project=~\"${project:regex}\" | session_id=~\"${session_id:regex}\" | tool_name=\"Bash\" | line_format `{{.tool_parameters}}` | json command=\"bash_command\" [5m]))",
          "legendFormat": "{{command}}",
          "interval": "5m"
        }
      ]
    },
    {
