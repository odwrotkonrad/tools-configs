          },
          "expr": "{service_name=\"claude-code\"} | event_name=\"tool_decision\" | project=~\"${project:regex}\" | session_id=~\"${session_id:regex}\" | tool_name=\"Bash\" | line_format `{{.tool_parameters}}` | json full_command=\"full_command\"",
