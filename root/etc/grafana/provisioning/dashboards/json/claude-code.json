        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "tsNs": true,
              "id": true,
              "bash_command": true,
              "tool_parameters": true,
              "tool_name": true,
              "app_entrypoint": true,
              "app_version": true,
              "cwd": true,
              "detected_level": true,
              "event_name": true,
              "event_timestamp": true,
              "flags": true,
              "host_arch": true,
              "observed_timestamp": true,
              "organization_id": true,
