{
  "uid": "claude-code",
  "title": "Claude Code",
  "tags": [
    "claude-code",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "refresh": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_session_count_total, project)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "session_id",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 3,
          "query": "query_result(sum by (session_id) (increase(claude_code_cost_usage_USD_total[$__range])) > 0)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/session_id=\"([^\"]+)\"/",
        "sort": 1
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_token_usage_tokens_total, model)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "tool_name",
        "label": "Tool",
        "type": "custom",
        "query": "AskUserQuestion,Bash,Edit,Read,Write",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "AskUserQuestion",
            "value": "AskUserQuestion",
            "selected": false
          },
          {
            "text": "Bash",
            "value": "Bash",
            "selected": false
          },
          {
            "text": "Edit",
            "value": "Edit",
            "selected": false
          },
          {
            "text": "Read",
            "value": "Read",
            "selected": false
          },
          {
            "text": "Write",
            "value": "Write",
            "selected": false
          }
        ],
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
