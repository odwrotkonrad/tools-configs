          },
          "expr": "label_join(sum by (project, session_id, model) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", model=~\"$model\"}[$__range])) and on (project, session_id, model) (sum by (project, session_id, model) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", model=~\"$model\"}[$__range])) > 0), \"pms\", \" / \", \"project\", \"session_id\", \"model\")",
          "instant": true,
          "format": "table",
          "range": false
        },
        {
          "refId": "linesAdded",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_join((sum by (project, session_id, model) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", model=~\"$model\"}[$__range])) and on (project, session_id, model) (sum by (project, session_id, model) (increase(claude_code_token_usage_tokens_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", model=~\"$model\"}[$__range])) > 0)) * 0 + on (project, session_id) group_left sum by (project, session_id) (increase(claude_code_lines_of_code_count_total{project!=\"\", project=~\"$project\", session_id=~\"$session_id\", type=\"added\"}[$__range])), \"pms\", \" / \", \"project\", \"session_id\", \"model\")",
