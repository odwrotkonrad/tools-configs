#[⌖] $ man git-config

[advice]
	statusHints = false
[gpg]
  format = ssh
[user]
  signingkey = ~/.ssh/id_signing.pub
  name = konradodwrot
  email = odwrotkonrad@gmail.com
[commit]
  gpgsign = true
  template = ~/.config/git/commit-template
[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
[init]
  defaultBranch = main
[color]
  ui = auto
[push]
  autoSetupRemote = true
  default = current
[core]
  hooksPath = ~/.config/git/hooks
[alias]
  lg = log --pretty=format:'%h %ar %s' --decorate -n 10


