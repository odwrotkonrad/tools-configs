#!/usr/bin/env sh
commit_msg=$(cat "$1")

if ! echo "$commit_msg" | grep -qE '^(feat|fix|refactor|perf|test|infra|ci|deps|config|scaffold|docs|chore|style)(\(.+\))?: .+'; then
    echo "error: commit message must start with a valid type prefix" >&2
    echo "       valid types: feat, fix, refactor, perf, test, infra, ci, deps, config, scaffold, docs, chore, style" >&2
    echo "       got: $commit_msg" >&2
    exit 1
fi
