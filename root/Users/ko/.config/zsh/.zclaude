#[≟] additional config file loaded only for claude spawned shells

#[≟] render manpage as plain text #[∵]
function man {
  mandoc -T utf8 -O indent=0 "$(/usr/bin/man -w "$@")" \
    | col -bx \
    | sed 's/^[[:space:]]*//' \
    | cat -s
}

# setopt xtrace # uncomment to see what claude shells are doing
