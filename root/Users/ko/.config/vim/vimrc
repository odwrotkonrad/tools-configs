set virtualedit=onemore

" Enable mouse support
set mouse=a

" Yank/paste use the system clipboard by default
set clipboard=unnamedplus

" Show line numbers
set number

" Keep up to 1000 levels of undo
set undolevels=1000

" A tab counts as 2 columns wide
set tabstop=2

" Auto-wrap inserted text
set textwidth=100

" Remember up to 1000 lines of command/search history
set history=1000

" toggle line wrap
set wrap

" line wrap on word boundaries
set linebreak

" highlight all matches when searching
set hls

" ignore case when searching
set ic

" cmd + c -> copy
vmap <Esc>[99;9u "+y


" Alt+Left / Alt+Right: move by word
nmap <M-Left>  b
nmap <M-Right> w

" Cmd+Left / Cmd+Right: beginning (first non-blank) / end of line
nmap <Esc>[1;9D ^
nmap <Esc>[1;9C $

" Alt+Up / Alt+Down: jump 10 lines
nmap <M-Up>   10k
nmap <M-Down> 10j

" Cmd+Up / Cmd+Down: jump to top / bottom of file
nmap <Esc>[1;9A gg
nmap <Esc>[1;9B G

" Plain backspace: delete one char back
nmap <BS> X

" Alt+Backspace: delete word backward
nmap <Esc>[127;3u db

" Cmd+Backspace: delete to start of line
nmap <Esc>[127;9u d0

" Delete: delete char forward
nmap <Del> x

" Alt+Delete: delete word forward
nmap <Esc>[3;3~ dw

" Cmd+Delete: delete to end of line
nmap <Esc>[3;9~ d$

" Cmd+Z: undo
nmap <Esc>[122;9u u

" Cmd+Shift+Z: redo
nmap Ú <C-r>

" Cmd+S: save file
nmap <Esc>[115;9u :update<CR>

" Cmd+W: quit, prompting to save if there are unsaved changes
nmap <Esc>[119;9u :confirm q<CR>

" Cmd+Shift+Up: select from cursor to top of file
nmap <Esc>[1;10A vgg

" Cmd+Shift+Down: select from cursor to bottom of file
nmap <Esc>[1;10B vG

" Shift+Arrows: start/extend selection (normal -> enters visual, visual -> extends)
nmap <Esc>[1;2A vk
nmap <Esc>[1;2B vj
nmap <Esc>[1;2D vh
nmap <Esc>[1;2C vl
vmap <Esc>[1;2A k
vmap <Esc>[1;2B j
vmap <Esc>[1;2D h
vmap <Esc>[1;2C l

" persistent undo — undo history is saved to disk and survives
set undofile

" undo files location
set undodir=$XDG_STATE_HOME/vim/undo//
