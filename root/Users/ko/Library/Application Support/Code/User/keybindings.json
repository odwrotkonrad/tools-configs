[
  //>[≟] layout
  // - primary sidebar (left): file explorer
  // - secondary sidebar (right): source control, extensions
  // - panel (top): search
  // - editor area: terminals, editors
  ///[≟]

  //>[≟] editor
  //[≟] alt+esc - close editor
  {
    "key": "alt+escape",
    "command": "workbench.action.closeActiveEditor",
    "when": "editorFocus && !view.workbench.view.search.visible"
  },
  //[≟] alt+r - reopen last closed tab
  {
    "key": "alt+r",
    "command": "workbench.action.reopenClosedEditor",
    "when": "!findWidgetVisible"
  },
  //[≟] alt+tab - cycle editors in group
  {
    "key": "alt+tab",
    "command": "workbench.action.nextEditorInGroup"
  },
  //[≟] alt+1 - cycle editor groups
  {
    "key": "alt+1",
    "command": "workbench.action.focusNextGroup",
    "when": "activeEditor"
  },
  //[≟] alt+down / alt+up - move lines
  {
    "key": "alt+down",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+up",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  //[≟] alt+f - find within current file
  {
    "key": "alt+f",
    "command": "actions.find",
    "when": "editorFocus"
  },
  //[≟] alt+r - toggle replace in find widget
  {
    "key": "alt+r",
    "command": "editor.action.startFindReplaceAction",
    "when": "findWidgetVisible && findInputFocussed"
  },

  {
    "key": "pageup",
    "command": "cursorTop",
    "when": "textInputFocus"
  },
  {
    "key": "pagedown",
    "command": "cursorBottom",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+up",
    "command": "cursorMove",
    "args": { "to": "up", "by": "line", "value": 12 },
    "when": "textInputFocus"
  },
  {
    "key": "cmd+down",
    "command": "cursorMove",
    "args": { "to": "down", "by": "line", "value": 12 },
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+up",
    "command": "cursorMove",
    "args": { "to": "up", "by": "line", "value": 3, "select": true },
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+down",
    "command": "cursorMove",
    "args": { "to": "down", "by": "line", "value": 3, "select": true },
    "when": "textInputFocus"
  },

  // editor actions
  {
    "key": "alt+/",
    "command": "editor.action.formatDocument",
    "when": "editorTextFocus && !editorHasSelection && !editorReadonly"
  },
  {
    "key": "alt+/",
    "command": "editor.action.formatSelection",
    "when": "editorTextFocus && editorHasSelection && !editorReadonly"
  },
  {
    "key": "alt+\\",
    "command": "editor.action.toggleWordWrap"
  },
  //[≟] f2 - rename the currently opened file
  {
    "key": "f2",
    "command": "runCommands",
    "args": {
      "commands": [
        "revealInExplorer",
        "renameFile"
      ]
    },
    "when": "editorFocus"
  },

  ///[≟] editor

  //>[≟] search
  //[≟] alt+q - quick text search
  {
    "key": "alt+q",
    "command": "workbench.action.quickTextSearch"
  },
  //[≟] alt+w - quick file open; toggle
  {
    "key": "alt+w",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "alt+w",
    "command": "workbench.action.closeQuickOpen",
    "when": "inQuickOpen"
  },
  //[≟] alt+g - open / close global search panel
  {
    "key": "alt+g",
    "command": "workbench.action.findInFiles"
  },
  {
    "key": "alt+g",
    "command": "workbench.action.closePanel",
    "when": "searchViewletFocus"
  },
  //[≟] alt+esc - close search panel
  {
    "key": "alt+escape",
    "command": "workbench.action.closePanel",
    "when": "searchViewletFocus"
  },
  //[≟] alt+f - move search (carry query) into search editor
  {
    "key": "alt+f",
    "command": "runCommands",
    "args": {
      "commands": [
        "search.action.openInEditor",
        "workbench.action.closePanel"
      ]
    },
    "when": "searchViewletFocus"
  },
  //[≟] alt+esc - close search editor without save prompt
  {
    "key": "alt+escape",
    "command": "workbench.action.revertAndCloseActiveEditor",
    "when": "inSearchEditor"
  },
  //[≟] alt+r - toggle replace in search view
  {
    "key": "alt+r",
    "command": "workbench.action.replaceInFiles",
    "when": "searchViewletFocus"
  },
  //[≟] enter - from search input, focus first result
  {
    "key": "enter",
    "command": "search.action.focusSearchList",
    "when": "searchViewletFocus && inputBoxFocus"
  },
  //[≟] esc - in search view, results -> input; input -> close
  {
    "key": "escape",
    "command": "workbench.action.findInFiles",
    "when": "searchViewletFocus && !inputBoxFocus"
  },
  {
    "key": "escape",
    "command": "workbench.action.closePanel",
    "when": "searchViewletFocus && inputBoxFocus"
  },
  //[≟] esc - from editor, return to search results
  {
    "key": "escape",
    "command": "search.action.focusSearchList",
    "when": "view.workbench.view.search.visible && editorTextFocus && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !renameInputVisible && !parameterHintsVisible"
  },
  //[≟] alt+esc - from editor, close it and return to search results
  {
    "key": "alt+escape",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeActiveEditor",
        "search.action.focusSearchList"
      ]
    },
    "when": "editorFocus && view.workbench.view.search.visible"
  },
  ///[≟] search

  //>[≟] terminal
  //>[≟] alt+t
  //  no terminal exists: create one in last editor group
  //  terminal exists: focus it (move panel terminal to editor, close aux bar)
  //  on terminal alone in group: jump to previous group
  //  on terminal with other editors in group: move to next editor in group
  ///[≟]
  {
    "key": "alt+t",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusLastEditorGroup",
        "workbench.action.createTerminalEditor"
      ]
    },
    "when": "!terminalIsOpen"
  },
  {
    "key": "alt+t",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusLastEditorGroup",
        "workbench.action.terminal.focus",
        "workbench.action.terminal.moveToEditor",
        "workbench.action.closeAuxiliaryBar"
      ]
    },
    "when": "terminalIsOpen"
  },
  {
    "key": "alt+t",
    "command": "workbench.action.focusPreviousGroup",
    "when": "activeEditor == 'terminalEditor' && groupEditorsCount == 1"
  },
  {
    "key": "alt+t",
    "command": "workbench.action.nextEditorInGroup",
    "when": "activeEditor == 'terminalEditor' && groupEditorsCount > 1"
  },
  //[≟] alt+f - find within terminal contents
  {
    "key": "alt+f",
    "command": "workbench.action.terminal.focusFind",
    "when": "terminalFocus"
  },
  //[≟] alt+esc - from terminal, jump to next editor group
  {
    "key": "alt+escape",
    "command": "workbench.action.focusNextGroup",
    "when": "terminalFocus"
  },
  //[≟] alt+shift+t - external terminal
  {
    "key": "alt+shift+t",
    "command": "workbench.action.terminal.openNativeConsole"
  },
  ///[≟] terminal

  //>[≟] file explorer
  //[≟] alt+a - open / toggle file explorer
  {
    "key": "alt+a",
    "command": "workbench.view.explorer",
    "when": "!explorerViewletFocus"
  },
  {
    "key": "alt+a",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "explorerViewletFocus"
  },
  //[≟] esc - from editor, reveal current file in explorer (when visible, no search)
  {
    "key": "escape",
    "command": "revealInExplorer",
    "when": "editorTextFocus && sideBarVisible && !view.workbench.view.search.visible && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !renameInputVisible && !parameterHintsVisible"
  },
  //[≟] enter - open file / toggle folder
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsFolder"
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && !inputFocus && explorerResourceIsFolder"
  },
  //[≟] alt+up / alt+down - jump 3 entries
  {
    "key": "alt+up",
    "command": "runCommands",
    "args": {
      "commands": ["list.focusUp", "list.focusUp", "list.focusUp"]
    },
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "alt+down",
    "command": "runCommands",
    "args": {
      "commands": ["list.focusDown", "list.focusDown", "list.focusDown"]
    },
    "when": "filesExplorerFocus && !inputFocus"
  },
  //[≟] f2 - rename
  {
    "key": "f2",
    "command": "renameFile",
    "when": "filesExplorerFocus && !inputFocus"
  },
  //[≟] esc - from explorer, focus the active editor
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "filesExplorerFocus && !inputFocus"
  },
  ///[≟] file explorer

  //>[≟] source control
  //[≟] alt+c - git view
  {
    "key": "alt+c",
    "command": "workbench.view.scm"
  },
  ///[≟] source control

  //>[≟] default unbinds
  { "key": "cmd+w", "command": "-workbench.action.closeActiveEditor" },
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeGroup",
    "when": "activeEditorGroupEmpty && multipleEditorGroups"
  },
  { "key": "shift+cmd+w", "command": "-workbench.action.closeWindow" },
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeWindow",
    "when": "!editorIsOpen && !multipleEditorGroups"
  },
  {
    "key": "cmd+w",
    "command": "-workbench.action.terminal.killEditor",
    "when": "terminalEditorFocus && terminalFocus && terminalHasBeenCreated || terminalEditorFocus && terminalFocus && terminalProcessSupported"
  },
  { "key": "cmd+q", "command": "-workbench.action.quit" }
  ///[≟] default unbinds

  ////[≟]  sequences sent to integrated terminal
  {
    "args": {
      "text": "\u0090z"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+z",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0090Z"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+shift+z",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0090x"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+x",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0015"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+backspace",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0017"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "alt+backspace",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0008"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "ctrl+backspace",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u001bb"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "alt+left",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u001bf"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "alt+right",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0001"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+left",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0005"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+right",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0090U"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+up",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0090D"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+down",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u001bp"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "alt+up",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u001bn"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "alt+down",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u001bd"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "alt+delete",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0090K"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+delete",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u0090w"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+w",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u001b[1;10A"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+shift+up",
    "when": "terminalFocus"
  },
  {
    "args": {
      "text": "\u001b[1;10B"
    },
    "command": "workbench.action.terminal.sendSequence",
    "key": "cmd+shift+down",
    "when": "terminalFocus"
  },
    //[≟] terminal - shift+enter just like alt+enter
  {
    "args": { "text": "\u001b\n" },
    "command": "workbench.action.terminal.sendSequence",
    "key": "shift+enter",
    "when": "terminalFocus"
  },
]
