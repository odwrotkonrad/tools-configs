{
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[graphql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "breadcrumbs.enabled": false,
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.disableAIFeatures": true,
  "chat.titleBar.signIn.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.preferredLocation": "panel",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "block-outline",
  "editor.cursorSurroundingLines": 1,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorWidth": 8,
  "editor.find.addExtraSpaceOnTop": false,
  "editor.find.autoFindInSelection": "multiline",
  "editor.find.loop": false,
  "editor.fontFamily": "Source Code Pro",
  "editor.fontSize": 13,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.maxLineCount": 1,
  "editor.suggest.filterGraceful": true,
  "editor.suggest.preview": true,
  "editor.suggest.showColors": false,
  "editor.suggest.showInlineDetails": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggestLineHeight": 0,
  "editor.wordWrap": "on",
  "editorconfig.generateAuto": false,
  "editorconfig.showMenuEntry": false,
  "explorer.compactFolders": true,
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "off",
  "files.insertFinalNewline": true,
  "git.blame.editorDecoration.template": "${hashShort}, (${authorDateAgo}), ${subject}",
  "git.blame.ignoreWhitespace": true,
  "git.branchSortOrder": "alphabetically",
  "git.confirmCommittedDelete": false,
  "git.confirmEmptyCommits": false,
  "git.confirmSync": false,
  "git.countBadge": "off",
  "git.defaultCloneDirectory": "~/projects/",
  "git.openAfterClone": "always",
  "git.openDiffOnClick": false,
  "git.promptToSaveFilesBeforeCommit": "never",
  "git.promptToSaveFilesBeforeStash": "never",
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".user"
  ],
  "git.showActionButton": {
    "commit": false,
    "publish": false,
    "sync": false
  },
  "git.showCommitInput": false,
  "git.showProgress": false,
  "git.suggestSmartCommit": false,
  "git.timeline.showAuthor": false,
  "git.timeline.showUncommitted": true,
  "git.untrackedChanges": "mixed",
  "git.useEditorAsCommitInput": false,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  "github.showAvatar": false,
  "prettier.configPath": "~/.config/prettier/.prettierrc.yml",
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,
  "ruff.configuration": "~/.config/ruff/ruff.toml",
  "ruff.format.preview": true,
  "search.exclude": {
    "**/.user/**": true
  },
  "search.smartCase": true,
  "terminal.external.osxExec": "kitty.app",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": true,
  "window.confirmSaveUntitledWorkspace": false,
  "window.customTitleBarVisibility": "auto",
  "window.density.editorTabHeight": "compact",
  "window.title": "${activeRepositoryName} ${separator} ${activeEditorMedium}",
  "window.titleBarStyle": "custom",
  "window.titleSeparator": " ━━ ",
  "window.zoomLevel": 1,
  "workbench.activityBar.compact": true,
  "workbench.activityBar.location": "hidden",
  "workbench.browser.showInTitleBar": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": true,
  "workbench.editor.labelFormat": "default",
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editor.tabSizing": "fixed",
  "workbench.layoutControl.enabled": false,
  "workbench.layoutControl.type": "menu",
  "workbench.navigationControl.enabled": false,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Solarized Light",
  "workbench.sideBar.location": "left",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "env": {
        "ZDOTDIR": "/Users/ko/.config/zsh"
      }
    },
  },
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.enableKittyKeyboardProtocol": true,
  "terminal.integrated.fontFamily": "Source Code Pro",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.showCommandGuide": true,
  "terminal.integrated.allowChords": true
}
