{
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Solarized Light",
  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      "editorCursor.foreground": "#ffffff",
      "terminalCursor.foreground": "#ffffff",
      "terminal.background": "#2a2a2a",
      "editor.background": "#1f1f1f",
      "list.focusBackground": "#ffffff30",
      "list.focusForeground": "#ffffff",
      "list.focusOutline": "#ffffffaa",
      "list.activeSelectionBackground": "#ffffff30",
      "list.activeSelectionForeground": "#ffffff",
      "list.inactiveSelectionBackground": "#00000000",
      "list.inactiveSelectionForeground": "#7a7a7a",
      "list.hoverBackground": "#00000000",
      "editor.lineHighlightBackground": "#ffffff30",
      "editor.lineHighlightBorder": "#ffffffaa",
      "editorGroup.border": "#3a3a3a",
      "editorGroup.focusedEmptyBorder": "#ffffff",
      "editorGroupHeader.tabsBorder": "#ffffff",
      "editorGroupHeader.tabsBackground": "#000000",
      "tab.inactiveBackground": "#0a0a0a",
      "tab.inactiveForeground": "#6a6a6a",
      "tab.unfocusedInactiveForeground": "#3a3a3a",
      "tab.activeBackground": "#1f1f1f",
      "tab.activeForeground": "#ffffff",
      "tab.activeBorder": "#ffffff",
      "tab.activeBorderTop": "#ffffff",
      "tab.unfocusedActiveBackground": "#0f0f0f",
      "tab.unfocusedActiveForeground": "#7a7a7a",
      "tab.unfocusedActiveBorder": "#00000000",
      "tab.unfocusedActiveBorderTop": "#00000000",
      "tab.hoverBackground": "#2a2a2a",
      "tab.hoverForeground": "#ffffff"
    },
    "[Solarized Light]": {
      "editorCursor.foreground": "#000000",
      "terminalCursor.foreground": "#000000",
      "terminal.background": "#e8dfc4",
      "editor.background": "#fdf6e3",
      "list.focusBackground": "#00000025",
      "list.focusForeground": "#000000",
      "list.focusOutline": "#000000aa",
      "list.activeSelectionBackground": "#00000025",
      "list.activeSelectionForeground": "#000000",
      "list.inactiveSelectionBackground": "#00000000",
      "list.inactiveSelectionForeground": "#93a1a1",
      "list.hoverBackground": "#00000000",
      "editor.lineHighlightBackground": "#00000025",
      "editor.lineHighlightBorder": "#000000aa",
      "editorGroup.border": "#c8bf9d",
      "editorGroup.focusedEmptyBorder": "#000000",
      "editorGroupHeader.tabsBorder": "#000000",
      "editorGroupHeader.tabsBackground": "#d6cdb4",
      "tab.inactiveBackground": "#e8dfc4",
      "tab.inactiveForeground": "#93a1a1",
      "tab.unfocusedInactiveForeground": "#c8bf9d",
      "tab.activeBackground": "#fdf6e3",
      "tab.activeForeground": "#000000",
      "tab.activeBorder": "#000000",
      "tab.activeBorderTop": "#000000",
      "tab.unfocusedActiveBackground": "#ece3c8",
      "tab.unfocusedActiveForeground": "#7a7a7a",
      "tab.unfocusedActiveBorder": "#00000000",
      "tab.unfocusedActiveBorderTop": "#00000000",
      "tab.hoverBackground": "#f5edd6",
      "tab.hoverForeground": "#000000"
    }
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[graphql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "breadcrumbs.enabled": false,
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.disableAIFeatures": true,
  "chat.titleBar.signIn.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.preferredLocation": "panel",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "block",
  "editor.cursorSurroundingLines": 1,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorWidth": 8,
  "editor.find.addExtraSpaceOnTop": false,
  "editor.find.autoFindInSelection": "multiline",
  "editor.find.loop": false,
  "editor.fontFamily": "Source Code Pro",
  "editor.fontSize": 13,
  "editor.formatOnSave": false,
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": false,
  "editor.renderLineHighlight": "none",
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  "editor.scrollBeyondLastLine": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "scm.diffDecorationsGutterVisibility": "always",
  "scm.diffDecorations": "all",
  "editor.renderLineHighlightOnlyWhenFocus": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.maxLineCount": 1,
  "editor.suggest.filterGraceful": true,
  "editor.suggest.preview": true,
  "editor.suggest.showColors": false,
  "editor.suggest.showInlineDetails": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggestLineHeight": 0,
  "editor.wordWrap": "on",
  "editorconfig.generateAuto": false,
  "editorconfig.showMenuEntry": false,
  "explorer.compactFolders": true,
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "search.actionsPosition": "auto",
  "search.collapseResults": "alwaysCollapse",
  "search.maxResults": null,
  "search.sortOrder": "modified",
  "search.searchOnType": false,
  "search.searchOnTypeDebouncePeriod": 0,
  "search.quickOpen.history.filterSortOrder": "recency",
  "search.mode": "view",
  "search.searchEditor.focusResultsOnSearch": true,
  "editor.find.seedSearchStringFromSelection": "always",
  "search.useIgnoreFiles": true,
  "search.useParentIgnoreFiles": false,
  "search.useReplacePreview": true,
  "search.useGlobalIgnoreFiles": false,
  "search.decorations.colors": true,
  "search.decorations.badges": true,
  "search.defaultViewMode": "list",
  "search.followSymlinks": true,
  "search.globalFindClipboard": false,
  "search.quickAccess.preserveInput": false,
  "search.quickOpen.includeHistory": true,
  "search.quickOpen.includeSymbols": false,
  "search.ripgrep.maxThreads": 0,
  "search.searchEditor.defaultNumberOfContextLines": 1,
  "search.searchEditor.doubleClickBehaviour": "openLocationToSide",
  "search.searchEditor.reusePriorSearchConfiguration": false,
  "search.searchEditor.singleClickBehaviour": "default",
  "search.searchView.keywordSuggestions": false,
  "search.searchView.semanticSearchBehavior": "manual",
  "search.seedOnFocus": false,
  "search.seedWithNearestWord": false,
  "search.showLineNumbers": false,
  "editor.occurrencesHighlight": "off",
  "git.addAICoAuthor": "off",
  "git.allowForcePush": true,
  "git.allowNoVerifyCommit": false,
  "git.alwaysShowStagedChangesResourceGroup": true,
  "git.alwaysSignOff": true,
  "git.autofetch": false,
  "git.autofetchPeriod": 0,
  "git.autorefresh": true,
  "git.autoRepositoryDetection": false,
  "git.autoStash": true,
  "git.blame.editorDecoration.disableHover": false,
  "git.blame.editorDecoration.enabled": false,
  "git.blame.editorDecoration.template": "${hashShort}, (${authorDateAgo}), ${subject}",
  "git.blame.ignoreWhitespace": true,
  "git.branchSortOrder": "alphabetically",
  "git.confirmCommittedDelete": false,
  "git.confirmEmptyCommits": false,
  "git.confirmSync": false,
  "git.countBadge": "off",
  "git.defaultCloneDirectory": "~/projects/",
  "git.openAfterClone": "always",
  "git.openDiffOnClick": true,
  "git.promptToSaveFilesBeforeCommit": "never",
  "git.promptToSaveFilesBeforeStash": "never",
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".user"
  ],
  "git.showActionButton": {
    "commit": false,
    "publish": false,
    "sync": false
  },
  "git.showCommitInput": false,
  "git.showProgress": false,
  "git.suggestSmartCommit": false,
  "git.timeline.showAuthor": false,
  "git.timeline.showUncommitted": true,
  "git.untrackedChanges": "mixed",
  "git.useEditorAsCommitInput": false,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  "git.decorations.enabled": true,
  "github.showAvatar": false,
  "prettier.configPath": "~/.config/prettier/.prettierrc.yml",
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,
  "ruff.configuration": "~/.config/ruff/ruff.toml",
  "ruff.format.preview": true,
  "search.exclude": {
    "**/.user/**": true
  },
  "search.smartCase": true,
  "terminal.external.osxExec": "kitty.app",
  "window.autoDetectColorScheme": true,
  "window.commandCenter": true,
  "window.confirmSaveUntitledWorkspace": false,
  "window.customTitleBarVisibility": "auto",
  "window.density.editorTabHeight": "compact",
  "window.title": "${activeRepositoryName} ${separator} ${activeEditorMedium}",
  "window.titleBarStyle": "custom",
  "window.titleSeparator": " ━━ ",
  "window.zoomLevel": 1,
  "workbench.activityBar.compact": true,
  "workbench.browser.showInTitleBar": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": true,
  "workbench.editor.labelFormat": "default",
  "workbench.editor.pinnedTabSizing": "normal",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editor.tabSizing": "fixed",
  "workbench.panel.alignment": "right",
  "workbench.panel.defaultLocation": "bottom",
  "workbench.layoutControl.enabled": false,
  "workbench.layoutControl.type": "menu",
  "workbench.navigationControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "env": {
        "ZDOTDIR": "/Users/ko/.config/zsh"
      }
    },
  },
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.enableKittyKeyboardProtocol": true,
  "terminal.integrated.fontFamily": "Source Code Pro",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.shellIntegration.showCommandGuide": true,
  "terminal.integrated.allowChords": true,
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.reopenClosedEditor",
    "workbench.action.closeAuxiliaryBar",
    "workbench.action.closePanel",
    "workbench.action.findInFiles",
    "workbench.action.terminal.focusFind",
    "workbench.action.closeSidebar",
    "workbench.action.focusActiveEditorGroup",
    "workbench.action.focusNextGroup",
    "workbench.action.focusPreviousGroup",
    "workbench.action.nextAuxiliaryBarView",
    "workbench.action.focusPanel",
    "workbench.action.quickOpen",
    "workbench.action.quickTextSearch",
    "workbench.action.terminal.focus",
    "workbench.action.terminal.focusFind",
    "workbench.action.terminal.toggleTerminal",
    "workbench.action.terminal.openNativeConsole",
    "workbench.extensions.action.focusExtensionsView",
    "workbench.files.action.focusFilesExplorer",
    "workbench.action.toggleSidebarVisibility",
    "workbench.scm.focus",
    "workbench.view.explorer",
    "workbench.view.extensions",
    "workbench.view.scm"
  ],
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.decorations.badges": true,
  "workbench.editor.decorations.colors": true,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.list.typeNavigationMode": "automatic",
  "workbench.quickOpen.includeHistory": false,
  "explorer.autoReveal": true,
  "explorer.confirmDelete": false,
  "explorer.autoOpenDroppedFile": true,
  "explorer.confirmUndo": "light",
  "explorer.confirmPasteNative": false,
  "explorer.enableUndo": true,
  "explorer.fileNesting.enabled": false,
  "explorer.decorations.badges": true,
  "explorer.decorations.colors": true,
  "explorer.excludeGitIgnore": false,
  "explorer.fileNesting.expand": false,
  "explorer.incrementalNaming": "smart",
  "explorer.sortOrder": "mixed",
  "workbench.secondarySideBar.forceMaximized": false,
  "workbench.sideBar.location": "left",
  "terminal.integrated.suggest.showStatusBar": false,
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.explorerKind": "both",
  "terminal.integrated.tabs.showActiveTerminal": "never",
  "terminal.integrated.rightClickBehavior": "default",
  "workbench.panel.showLabels": false,
  "problems.decorations.enabled": false,
  "problems.autoReveal": false,
  "outline.problems.enabled": false,
  "outline.problems.colors": false,
  "terminal.integrated.detectLocale": "auto",
  "terminal.integrated.enableImages": false,
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.enableNotifications": false,
  "terminal.integrated.enableFileLinks": "notRemote",
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.tabs.showActions": "never",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.tabs.allowAgentCliTitle": false,
  "terminal.integrated.tabs.title": "${process}",
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.tabs.hideCondition": "singleGroup",
  "terminal.integrated.shellIntegration.decorationsEnabled": "both",
  "terminal.integrated.lineHeight": 1,
  "terminal.integrated.splitCwd": "workspaceRoot",
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.cursorStyleInactive": "none",
  "terminal.integrated.bellDuration": 0,
  "terminal.integrated.confirmOnExit": "never",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.hideOnLastClosed": false,
  "terminal.integrated.suggest.cdPath": "off",
  "terminal.integrated.suggest.inlineSuggestion": "off",
  "terminal.integrated.suggest.insertTrailingSpace": false,
  "terminal.integrated.suggest.providers": {},
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "off",
    "arguments": "off",
    "unknown": "off"
  },
  "terminal.integrated.suggest.runOnEnter": "never",
  "terminal.integrated.suggest.selectionMode": "never",
  "terminal.integrated.suggest.suggestOnTriggerCharacters": false,
  "terminal.integrated.suggest.upArrowNavigatesHistory": false,
  "terminal.integrated.shellIntegration.environmentReporting": false,
  "terminal.integrated.shellIntegration.history": 0,
  "terminal.integrated.shellIntegration.quickFixEnabled": false,
  "terminal.integrated.shellIntegration.timeout": -1,
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.textBlinking": false,
  "terminal.external.linuxExec": "xterm",
  "terminal.integrated.accessibleViewFocusOnCommandExecution": false,
  "terminal.integrated.hideOnStartup": "never",
  "terminal.integrated.autoReplies": {},
  "terminal.integrated.smoothScrolling": true,
  "workbench.secondarySideBar.defaultVisibility": "maximized",
  "workbench.activityBar.location": "hidden",
  "editor.accessibilitySupport": "off",
}
