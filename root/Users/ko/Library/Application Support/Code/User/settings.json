{
  //[…] window
  "window.autoDetectColorScheme": true,
  "window.confirmBeforeClose": "keyboardOnly",
  "window.confirmSaveUntitledWorkspace": false,
  "window.density.editorTabHeight": "compact",
  "window.newWindowDimensions": "inherit",
  "window.restoreWindows": "preserve",
  "window.systemColorTheme": "auto",
  "window.title": "${activeRepositoryName} ${separator} ${activeEditorMedium}",
  "window.titleSeparator": " ━━ ",
  "window.zoomLevel": 2,
  "update.titleBar": false, //[≟] update indicator in the title bar
  //[⫶]

  //[…] workbench
  "workbench.activityBar.autoHide": true,
  "workbench.browser.showInTitleBar": false,
  "workbench.colorTheme": "Solarized Light", //[∵] fallback when system theme detection fails
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.decorations.badges": true,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.languageDetection": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 5,
  "workbench.editor.splitSizing": "distribute",
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editor.titleScrollbarVisibility": "hidden",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "workbench.panel.defaultLocation": "top",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Solarized Light",
  "workbench.secondarySideBar.defaultVisibility": "visible",
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  "workbench.tips.enabled": false,
  "workbench.tree.renderIndentGuides": "none",

  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      "editor.background": "#1f1f1f",
      "editor.lineHighlightBackground": "#ffffff30",
      "editor.lineHighlightBorder": "#ffffffaa",
      "editorCursor.foreground": "#ffffff",
      "editorGroup.border": "#3a3a3a",
      "editorGroup.focusedEmptyBorder": "#ffffff",
      "editorGroupHeader.tabsBackground": "#000000",
      "editorGroupHeader.tabsBorder": "#ffffff",
      "list.activeSelectionBackground": "#ffffff30",
      "list.activeSelectionForeground": "#ffffff",
      "list.focusBackground": "#ffffff30",
      "list.focusForeground": "#ffffff",
      "list.focusOutline": "#ffffffaa",
      "list.hoverBackground": "#00000000",
      "list.inactiveSelectionBackground": "#00000000",
      "list.inactiveSelectionForeground": "#7a7a7a",
      "tab.activeBackground": "#1f1f1f",
      "tab.activeBorder": "#ffffff",
      "tab.activeBorderTop": "#ffffff",
      "tab.activeForeground": "#ffffff",
      "tab.hoverBackground": "#2a2a2a",
      "tab.hoverForeground": "#ffffff",
      "tab.inactiveBackground": "#0a0a0a",
      "tab.inactiveForeground": "#6a6a6a",
      "tab.unfocusedActiveBackground": "#0f0f0f",
      "tab.unfocusedActiveBorder": "#00000000",
      "tab.unfocusedActiveBorderTop": "#00000000",
      "tab.unfocusedActiveForeground": "#7a7a7a",
      "tab.unfocusedInactiveForeground": "#3a3a3a",
      "terminal.background": "#2a2a2a",
      "terminalCursor.foreground": "#ffffff"
    },
    "[Solarized Light]": {
      "editor.background": "#fdf6e3",
      "editor.lineHighlightBackground": "#00000025",
      "editor.lineHighlightBorder": "#000000aa",
      "editorCursor.foreground": "#000000",
      "editorGroup.border": "#c8bf9d",
      "editorGroup.focusedEmptyBorder": "#000000",
      "editorGroupHeader.tabsBackground": "#d6cdb4",
      "editorGroupHeader.tabsBorder": "#000000",
      "list.activeSelectionBackground": "#00000025",
      "list.activeSelectionForeground": "#000000",
      "list.focusBackground": "#00000025",
      "list.focusForeground": "#000000",
      "list.focusOutline": "#000000aa",
      "list.hoverBackground": "#00000000",
      "list.inactiveSelectionBackground": "#00000000",
      "list.inactiveSelectionForeground": "#93a1a1",
      "tab.activeBackground": "#fdf6e3",
      "tab.activeBorder": "#000000",
      "tab.activeBorderTop": "#000000",
      "tab.activeForeground": "#000000",
      "tab.hoverBackground": "#f5edd6",
      "tab.hoverForeground": "#000000",
      "tab.inactiveBackground": "#e8dfc4",
      "tab.inactiveForeground": "#93a1a1",
      "tab.unfocusedActiveBackground": "#ece3c8",
      "tab.unfocusedActiveBorder": "#00000000",
      "tab.unfocusedActiveBorderTop": "#00000000",
      "tab.unfocusedActiveForeground": "#7a7a7a",
      "tab.unfocusedInactiveForeground": "#c8bf9d",
      "terminal.background": "#e8dfc4",
      "terminalCursor.foreground": "#000000"
    },
  },
  //[⫶]

  //[…] editor
  "editor.accessibilitySupport": "off",
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "block",
  "editor.cursorSurroundingLines": 1,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorWidth": 8,
  "editor.find.addExtraSpaceOnTop": false,
  "editor.find.autoFindInSelection": "never",
  "editor.find.loop": false,
  "editor.folding": false, //[∵] more space for contents; toggled on with sticky scroll via alt+p
  "editor.fontFamily": "'JetBrains Mono'",
  "editor.fontSize": 12,
  "editor.formatOnSave": false,
  "editor.glyphMargin": false, //[∵] more space for contents
  "editor.guides.highlightActiveIndentation": false,
  "editor.guides.indentation": false,
  "editor.hideCursorInOverviewRuler": false,
  "editor.lineNumbers": "off", //[∵] more space for contents
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.overviewRulerBorder": false,
  "editor.renderLineHighlight": "none",
  "editor.renderLineHighlightOnlyWhenFocus": true,
  "editor.scrollbar.horizontalScrollbarSize": 2,
  "editor.scrollbar.verticalScrollbarSize": 2,
  "editor.scrollBeyondLastLine": false,
  "editor.stickyScroll.maxLineCount": 1,
  "editor.tabSize": 2, //[≟] columns a Tab char occupies; editor.indentSize defaults to "tabSize" so indent width follows
  "editor.suggest.preview": true,
  "editor.suggest.showColors": false,
  "editor.suggest.showStatusBar": true,
  "editor.wordBasedSuggestions": "off",
  "editor.fontLigatures": true,

  //[⫶]

  //[…] explorer
  "explorer.autoReveal": "focusNoScroll",
  "explorer.autoOpenDroppedFile": false,
  "explorer.confirmDelete": false,
  "explorer.confirmPasteNative": false,
  "explorer.confirmUndo": "light",
  "explorer.incrementalNaming": "smart",
  "explorer.sortOrder": "type",
  //[⫶]

  //[…] search
  "search.actionsPosition": "auto",
  "search.collapseResults": "alwaysCollapse",
  "search.experimental.useIgnoreFilesInFindFiles": true,
  "search.globalFindClipboard": true,
  "search.maxResults": null,
  "search.quickOpen.includeHistory": false,
  "search.searchEditor.doubleClickBehaviour": "selectWord",
  "search.searchEditor.focusResultsOnSearch": true,
  "search.searchOnType": false,
  "search.seedOnFocus": true,
  "search.seedWithNearestWord": true,
  "search.showLineNumbers": false,
  "search.smartCase": true,
  "search.sortOrder": "modified",
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,
  //[⫶]

  //[…] source control

  //[……] git
  "git.allowForcePush": true,
  "git.alwaysShowStagedChangesResourceGroup": true,
  "git.alwaysSignOff": true,
  "git.autoRepositoryDetection": false,
  "git.blame.editorDecoration.enabled": false,
  "git.blame.editorDecoration.template": "(${authorDateAgo} ${authorEmail}): ${subject}",
  "git.blame.statusBarItem.enabled": false,
  "git.branchSortOrder": "committerdate",
  "git.closeDiffOnOperation": true,
  "git.confirmCommittedDelete": false,
  "git.confirmEmptyCommits": false,
  "git.confirmNoVerifyCommit": false,
  "git.confirmSync": false,
  "git.countBadge": "off",
  "git.decorations.enabled": false,
  "git.defaultCloneDirectory": "~/.local/share/projects",
  "git.diagnosticsCommitHook.enabled": true,
  "git.enableCommitSigning": true,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.inputValidation": true,
  "git.inputValidationLength": 500,
  "git.inputValidationSubjectLength": 180,
  "git.mergeEditor": true,
  "git.openAfterClone": "alwaysNewWindow",
  "git.openDiffOnClick": true,
  "git.openRepositoryInParentFolders": "never",
  "git.optimisticUpdate": false,
  "git.path": "/opt/homebrew/bin/git",
  "git.pruneOnFetch": true,
  "git.pullBeforeCheckout": true,
  "git.rebaseWhenSync": true,
  "git.statusLimit": 0,
  "git.terminalGitEditor": true,
  "git.timeline.showAuthor": false,
  "git.timeline.showUncommitted": true,
  "git.untrackedChanges": "mixed",
  "git.useCommitInputAsStashMessage": true,
  "git.useForcePushIfIncludes": false, //[∵] frequent amends break the includes check
  "git.useForcePushWithLease": true,
  "git.useIntegratedAskPass": true,
  "git.showActionButton": {
    "commit": false,
    "publish": false,
    "sync": false
  },
  //[⫶⫶]

  //[……] scm
  "scm.alwaysShowRepositories": false,
  "scm.autoReveal": false,
  "scm.compactFolders": true,
  "scm.countBadge": "off",
  "scm.defaultViewSortKey": "status",
  "scm.diffDecorations": "gutter",
  "scm.diffDecorationsGutterAction": "none",
  "scm.diffDecorationsIgnoreTrimWhitespace": "inherit",
  "scm.graph.badges": "filter",
  "scm.graph.pageSize": 200,
  "scm.graph.showIncomingChanges": false,
  "scm.graph.showOutgoingChanges": false,
  "scm.inputFontFamily": "editor",
  "scm.inputMaxLineCount": 15,
  "scm.inputMinLineCount": 2,
  "scm.providerCountBadge": "hidden",
  "scm.repositories.selectionMode": "single",
  "scm.showActionButton": false,
  "scm.diffDecorationsGutterPattern": {
    "added": false,
    "modified": true
  },
  //[⫶⫶]

  //[⫶]


  //[…] terminal
  "terminal.external.osxExec": "Kitty.app",
  "terminal.integrated.allowChords": false,
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorStyleInactive": "underline",
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.detectLocale": "off",
  "terminal.integrated.enableFileLinks": "notRemote",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.environmentChangesRelaunch": false,
  "terminal.integrated.fastScrollSensitivity": 2,
  "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font Mono'",
  "terminal.integrated.fontLigatures.enabled": false,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.initialHintCopilotCli": false,
  "terminal.integrated.letterSpacing": 1,
  "terminal.integrated.localEchoEnabled": "on",
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.rightClickBehavior": "default",
  "terminal.integrated.scrollback": 100000,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.showLinkHover": false,
  "terminal.integrated.smoothScrolling": false,
  "terminal.integrated.splitCwd": "workspaceRoot",
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.tabs.allowAgentCliTitle": false,
  "terminal.integrated.tabs.showActions": "never",
  "terminal.integrated.tabs.showActiveTerminal": "never",
  "terminal.integrated.tabs.title": "${shellType}",

  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "/bin/zsh",
      "env": {
        "ZDOTDIR": "/Users/ko/.config/zsh"
      }
    },
  },

  "terminal.integrated.commandsToSkipShell": [
    "editor.action.fontZoomIn",
    "editor.action.fontZoomOut",
    "editor.action.fontZoomReset",
    "runCommands",
    "search.action.focusSearchList",
    "search.action.openNewEditor",
    "workbench.action.closeAuxiliaryBar",
    "workbench.action.closePanel",
    "workbench.action.closeSidebar",
    "workbench.action.createTerminalEditor",
    "workbench.action.createTerminalEditorSameGroup",
    "workbench.action.evenEditorWidths",
    "workbench.action.findInFiles",
    "workbench.action.focusActiveEditorGroup",
    "workbench.action.focusAuxiliaryBar",
    "workbench.action.focusFirstEditorGroup",
    "workbench.action.focusLastEditorGroup",
    "workbench.action.focusNextGroup",
    "workbench.action.focusPanel",
    "workbench.action.focusPreviousGroup",
    "workbench.action.focusSecondEditorGroup",
    "workbench.action.focusSideBar",
    "workbench.action.navigateDown",
    "workbench.action.navigateLeft",
    "workbench.action.navigateRight",
    "workbench.action.navigateUp",
    "workbench.action.nextAuxiliaryBarView",
    "workbench.action.nextEditorInGroup",
    "workbench.action.quickOpen",
    "workbench.action.quickTextSearch",
    "workbench.action.reopenClosedEditor",
    "workbench.action.terminal.focus",
    "workbench.action.terminal.focusFind",
    "workbench.action.terminal.focusFind",
    "workbench.action.terminal.fontZoomIn",
    "workbench.action.terminal.fontZoomOut",
    "workbench.action.terminal.fontZoomReset",
    "workbench.action.terminal.killEditor",
    "workbench.action.terminal.openNativeConsole",
    "workbench.action.terminal.toggleTerminal",
    "workbench.action.toggleSidebarVisibility",
    "workbench.extensions.action.focusExtensionsView",
    "workbench.files.action.focusFilesExplorer",
    "workbench.scm.focus",
    "workbench.scm.history.focus",
    "workbench.view.explorer",
    "workbench.view.extensions",
    "workbench.view.scm"
  ],
  //[⫶]

  //[…] Claude Code
  "claudeCode.useCtrlEnterToSend": true,
  "claudeCode.hideOnboarding": true,
  "claudeCode.initialPermissionMode": "default",
  "claudeCode.respectGitIgnore": false,
  "claudeCode.enableNewConversationShortcut": true,
  "claudeCode.usePythonEnvironment": false,
  "claudeCode.useTerminal": true,
  "claudeCode.enableReopenClosedSessionShortcut": false,
  "claudeCode.autosave": false,
  //[⫶]


  // TODO below settings - split to actually set / defaults
  //[…] misc
  "breadcrumbs.enabled": false,
  "files.insertFinalNewline": true,
  "problems.decorations.enabled": false,
  "problems.autoReveal": false,
  "outline.problems.enabled": false,
  "outline.problems.colors": false,
  "debug.console.wordWrap": true,
  //[⫶]

  //[…] files
  "files.enableTrash": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  //[⫶]

  //[…] per-language formatters
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[graphql]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  //[⫶]
  //[…] extensions
  "extensions.ignoreRecommendations": true,

  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.allowDangerouslySkipPermissions": false,

  "editorconfig.generateAuto": false,
  "editorconfig.showMenuEntry": false,

  "prettier.configPath": "~/.config/prettier/.prettierrc.yml",
  "prettier.requireConfig": true,
  "prettier.useEditorConfig": true,

  "ruff.configuration": "~/.config/ruff/ruff.toml",
  "ruff.format.preview": true,

  "github.showAvatar": false,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false
  },
  //[⫶]

  //[…] diff editor
  "diffEditor.codeLens": false,
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.experimental.showEmptyDecorations": true,
  "diffEditor.experimental.showMoves": false,
  "diffEditor.renderSideBySide": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.wordWrap": "inherit",
  "workbench.secondarySideBar.showLabels": false,
  "workbench.panel.showLabels": false,
  "workbench.activityBar.compact": true,
  "chat.viewSessions.orientation": "stacked",

  //[⫶]
}
