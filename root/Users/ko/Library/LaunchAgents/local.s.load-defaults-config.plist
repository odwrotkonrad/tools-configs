<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.s.load-defaults-config</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/s_load_defaults_config</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/ko/Library/Logs/s_load_defaults_config.log</string>
	<key>StandardInPath</key>
	<string>/etc/defaults.yml</string>
	<key>StandardOutPath</key>
	<string>/Users/ko/Library/Logs/s_load_defaults_config.log</string>
	<key>ThrottleInterval</key>
	<integer>1</integer>
</dict>
</plist>
