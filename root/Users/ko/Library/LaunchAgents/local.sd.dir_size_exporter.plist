<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.sd.dir_size_exporter</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/scripts/s_export_dir_sizes</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/ko/.local/state/log/dir_size_exporter.log</string>
	<key>StandardOutPath</key>
	<string>/Users/ko/.local/state/log/dir_size_exporter.log</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
