#!/bin/zsh
#>[≟]
#   Symlink every file under <configs>/root into the system root.
#   Mirrors the directory structure and replaces any existing regular file / link.
#/[≟]

set -e

configs=${1:-$HOME/projects/configs}

pushd "$configs/root"
find * -type d -exec mkdir -p /{} \;
find * -type f -exec ln -fvws "$PWD"/{} /{} \;
popd
