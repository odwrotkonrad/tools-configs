#[what] fn-comp-file-fetch <bin> <comp-file> <url>: fetch a zsh completion file via fn-comp-file-write, skipping when already present

##[>] 🤖🤖
function fn-comp-file-fetch {
  emulate -LR zsh
  autoload -Uz fn-log-msg fn-comp-file-write
  local dir=/etc/zsh/zshrc.d/completions
  if [[ "$(whence -p $1)" == ${HOME}/* ]] dir=${XDG_STATE_HOME}/zsh/completions
  if [[ -e $dir/$2 ]] {
    fn-log-msg -t 'completions(skip)' -- "$1 -> $2 cached"
    return
  }
  fn-comp-file-write $1 $2 < <(curl -fsSL --connect-timeout 30 --retry 10 --retry-delay 30 --retry-all-errors $3)
}
