#[what] fn-install-if-missing <cmd> <installer-fn>: skip+log if cmd present, else log+run+log

function fn-install-if-missing {
  emulate -LR zsh
  autoload -Uz fn-log-msg
  local cmd=$1 installer=$2

  if (( $+commands[$cmd] )) {
    ##[>] 🤖🤖
    #[why] best effort: not every tool has --version (go wants `go version`, kubectx has neither), blank falls back to the bare message
    local ver=$($commands[$cmd] --version 2>/dev/null | head -1)
    [[ -n $ver ]] || ver=$($commands[$cmd] version 2>/dev/null | head -1)
    fn-log-msg -t $cmd -- "already installed${ver:+ ($ver)}"
    ##[<] 🤖🤖
    return
  }

  fn-log-msg -t $cmd -- installing
  $installer
  fn-log-msg -t $cmd -- installed
}
