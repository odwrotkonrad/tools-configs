#>[what]
#   load /etc/zsh/zshrc.d/static-history.d/* and ${ZDOTDIR}/zshrc.d/static-history.d/*
#   (name order) into the in-memory history list; comment lines dropped,
#   whitespace before an inline comment folded to two spaces
#/[what]

function fn-load-static-history {
  emulate -LR zsh

  ##[>] 🤖🤖
  local tmp=$(mktemp)
  local cmd_line_re='^(\w.*)'
  local inline_comment_re='\s+(#)'
  local -a hist_files=(
    /etc/zsh/zshrc.d/static-history.d/*(N)
    ${ZDOTDIR:-${HOME}/.config/zsh}/zshrc.d/static-history.d/*(N)
  )
  (( $#hist_files )) || return 0

  rg $cmd_line_re --no-line-number --no-filename --no-multiline $hist_files \
    | rg $inline_comment_re -r '  $1' --passthru >| "$tmp"

  fc -R "$tmp"
  rm -f "$tmp"
  ##[<] 🤖🤖
}
