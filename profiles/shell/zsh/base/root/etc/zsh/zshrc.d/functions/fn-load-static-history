#>[what]
# purpose of this function is to load commands from /etc/zsh/zshrc.d/static-history.d/* and ${ZDOTDIR}/zshrc.d/static-history.d/* (name order) into in memory history list
# comment lines are removed
# whitespace before comments is folded into two spaces
#/[what]

function fn-load-static-history {
  emulate -LR zsh

  local TEMP_HIST=$(mktemp)
  local RGX_LINE='^(\w.*)'  #[what] match commands (starting with a word character)
  local RGX_COMMENT='\s+(#)' #[what] match whitespace before comment (#)
  ##[>] 🤖🤖
  local -a hist_files=(
    /etc/zsh/zshrc.d/static-history.d/*(N)
    ${ZDOTDIR:-${HOME}/.config/zsh}/zshrc.d/static-history.d/*(N)
  )
  (( $#hist_files )) || return 0

  rg $RGX_LINE --no-line-number --no-filename --no-multiline $hist_files \
    | rg $RGX_COMMENT -r '  $1' --passthru >| "$TEMP_HIST"
  ##[<] 🤖🤖

  fc -R "$TEMP_HIST"
}
