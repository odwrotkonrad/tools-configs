# brew bundle manifest, staged + gated by brew-packages.zsh via HOMEBREW_STAGE +
# HOMEBREW_IS_VIRT (HOMEBREW_-prefixed: survives brew's sanitizer)

def stage?(s) = ENV["HOMEBREW_STAGE"] == s
def virt?     = ENV["HOMEBREW_IS_VIRT"] == "true"

##[>] formulae
if stage?("formulae")
  if OS.mac?                                 ##[ai] 🤖 mac only: linux keeps the tarball-installed che
    tap "konradodwrot/tap"                   ##[ai] 🤖 che tap, mirrored to github.com/konradodwrot/homebrew-tap
    brew "konradodwrot/tap/che"              ##[ai] 🤖 Spec-driven dotfile configuration loader
  end
  brew "readline"      # Library for command-line editing
  brew "openssl@3"     # Cryptography and SSL/TLS Toolkit
  brew "bat"           # Clone of cat(1) with syntax highlighting and Git integration
  brew "bats-core"     # Bash Automated Testing System
  brew "fd"            # Simple, fast and user-friendly alternative to find
  brew "ffmpeg"        # Play, record, convert, and stream audio and video codecs
  brew "xz"            # General-purpose data compression with high compression ratio
  brew "zstd"          # Zstandard is a real-time compression algorithm
  brew "gcc"           # GNU compiler collection
  brew "pcre2"         # Perl compatible regular expressions library with a new API
  brew "htop"          # Improved top (interactive process viewer)
  brew "jq"            # Lightweight and flexible command-line JSON processor
  brew "sqlite"        # Command-line interface for SQLite
  brew "libtool"       # Generic library support script
  brew "make"          # Utility for directing compilation
  brew "nmap"          # Port scanning utility for large networks
  brew "pandoc"        # Swiss-army knife of markup format conversion
  brew "pkgconf"       # Package compiler and linker metadata toolkit
  brew "procs"         # Modern replacement for ps written in Rust
  brew "pstree"        # Show ps output as a tree
  brew "shellcheck"    # Static analysis and lint tool, for (ba)sh scripts
  brew "showkey"       # Simple keystroke visualizer
  brew "stow"          # Organize software neatly under a single directory tree
  brew "tcl-tk"        # Tool Command Language
  brew "tree"          # Display directories as trees
  brew "watch"         # Executes a program periodically, showing output fullscreen
  brew "yq"            # Process YAML, JSON, XML, CSV and properties from the CLI
  brew "zlib"          # General-purpose lossless data-compression library
end
##[<] formulae

##[>] npm
if stage?("npm")
  npm "@github/copilot"
  npm "ccstatusline@2.2.22"
end
##[<] npm

##[>] cask
if stage?("cask")
  cask "beekeeper-studio" unless virt?     ##[ai] 🤖 SQL GUI (SQLite/Postgres/MySQL/MariaDB)
end
##[<] cask
