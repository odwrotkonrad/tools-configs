#[why] control derives its dependency graph from each repo's .repo/cross-repo-interface.yml:
#   without this the file is swallowed by **/.*, stays untracked, invisible to git status, and
#   the graph reports no producer for whatever that repo publishes
!**/.repo/

!**/.gitignore
!**/.dockerignore
!**/.python-version
!**/.gitlab-ci.yml
!**/.golangci.yml
!**/.env.example
!**/.env.tpl

