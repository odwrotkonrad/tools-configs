#[what] inline each '@path' stdin line as the contents of $1/<path>; '~/' -> root-ln/Users/ko/

function tmpl-resolve-at-includes {
  local base=$1
  local line path
  while IFS= read -r line; do
    if [[ $line == '@'[^[:space:]]* && $line != *[[:space:]]* ]] {
      path=${line#@}
      path=${path/#\~\//root-ln/Users/ko/} #[what] /# - anchor match to the front
      print -r -- "$(<$base/${path})"
    } else {
      print -r -- $line
    }
  done
}
