#!/bin/zsh
#>[what]
#   Load <configs> into the system root, mirroring directory structure.
#   <configs>/root files are symlinked by default (live, follow the repo).
#   *.host.auto.cp files are copied (marker stripped); excluded from linking.
#   *.auto.tmpl files are rendered by the template loader; excluded here.
#/[what]

emulate -LR zsh
setopt errexit dotglob
IFS= # do not split into multiple args on spaces e.g. 'Application Support'
autoload -Uz log-msg fn-root-backup-if-exists
configs=${1:-$HOME/projects/configs}

: ${HOME:?HOME must be set} #[why] dest paths derive from the invoking user's home

if (( EUID != 0 )) { print -u2 "must run as root"; exit 1 }

#[what] map a repo-relative path to its live dest: HOME or HOME/<rest> -> $HOME[/<rest>], else /<rest>
function to_dest { [[ $1 == HOME || $1 == HOME/* ]] && print -r -- ${HOME}${1#HOME} || print -r -- /$1 }

#[what] copied dests with explicit owner:perms; format 'owner:group mode'
#[why] sole source of owner/perms; root-owned launchd daemons must be root:wheel 0644
typeset -A perms=()
for d ( dir-size-exporter grafana jaeger loki otelcol port-exporter prometheus ) {
  perms[/Library/LaunchDaemons/d-root-$d.plist]='root:wheel 0644'
}

pushd "$configs/root"

typeset -a repo_files repo_dirs ex repo_files_ex copy_files
typeset -aU repo_dirs_all

cp_ext='.host.auto.cp'

# 1. get files from git; classify by extension
ex=( **/*.auto.tmpl **/*${cp_ext} ) #[what] templates + copies excluded from the link pass
repo_files=( ${(f)$(git ls-files --exclude-standard)} )
repo_dirs=( ${(u)repo_files:h} )
repo_files_ex=( ${repo_files:|ex} ) #[what] link-pass set
copy_files=( **/*${cp_ext} )        #[what] copy-pass set

#[what] 🤖🤖 add every ancestor dir #[why] plain mkdir (no -p) needs each parent made + owned, not just the leaf
#[why] built from ALL repo files (links + copies) so parents exist for both passes
for dir ( $repo_dirs ) { while [[ $dir == */* ]] { repo_dirs_all+=$dir; dir=$dir:h }; repo_dirs_all+=$dir } #[what] 🤖🤖

# 2. create dirs (parents first) #[what] 🤖🤖
home_user=${SUDO_USER:-$(stat -f '%Su' -- $HOME)} #[why] root runs this; HOME-tree dirs belong to the invoking user (SUDO_USER), not root
for dir ( ${(o)repo_dirs_all} ) {  #[what] 🤖🤖 (o) sort -> parents before children
  ddir=$(to_dest $dir)
  if [[ -d $ddir ]] { continue }
  if [[ $dir == HOME/* ]] {  #[what] 🤖🤖 HOME-tree: made as the user (user-owned, no chown), 0750 (group read, no world)
    (umask 027; sudo -u $home_user mkdir $ddir); log-msg -t mkdir -- $ddir
  } else {
    (umask 022; mkdir $ddir); log-msg -t mkdir -- $ddir  #[what] 🤖🤖 root-tree: 0755 (world-readable); no -p
  }
}

##[>] link pass
for file ( $repo_files_ex ) {
  dest=$(to_dest $file)
  if [[ ${dest:A} != ${file:A} ]] {
    fn-root-backup-if-exists --repo-root $configs $dest  #[what] keep any non-repo dest first
    ln -fws ${file:a} $dest ; log-msg -t ln -- $dest
  }
}
##[<] link pass

##[>] copy pass
for file ( $copy_files ) {
  dest=$(to_dest ${file%${cp_ext}}) #[what] strip marker -> live path
  if { ! cmp -s ${file:a} $dest } {
    fn-root-backup-if-exists $dest  #[what] a real copied dest is never a repo-pointing symlink (no --repo-root)
    if [[ ${file%${cp_ext}} == HOME/* ]] { (umask 027; cp ${file:a} $dest) } else { (umask 022; cp ${file:a} $dest) } #[what] 🤖🤖 HOME-tree 0640, root-tree 0644
    log-msg -t cp -- $dest
    if [[ -n ${perms[$dest]} ]] {
      perm=${perms[$dest]}
      chown -- ${perm%% *} $dest; log-msg -t chown -- "${perm%% *} $dest"
      chmod -- ${perm##* } $dest; log-msg -t chmod -- "${perm##* } $dest"
    }
  }
}
##[<] copy pass
popd
