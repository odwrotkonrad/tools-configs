#!/bin/zsh
#>[what]
#   Load <configs> into the system root, mirroring directory structure.
#   <configs>/root-ln files are symlinked (live, follow the repo).
#   <configs>/root-cp files are copied as root
#/[what]

emulate -LR zsh
setopt errexit dotglob
IFS= # do not split into multiple args on spaces e.g. 'Application Support'
autoload -Uz log-msg
configs=${1:-/Users/ko/projects/configs}


if (( EUID != 0 )) { print -u2 "must run as root"; exit 1 }

function cp_owner {
  local src=$1
  local dest=$2
  local owner=$(stat -f '%u:%g' -- $src)

  # -h - change owner of the link
  chown -h -- $owner $dest ; log-msg -t chown -- "$owner $dest"  #[what] -h: the link itself, not its target
}

function cp_perms {
  local src=$1
  local dest=$2
  local perms=$(stat -f '%Lp' -- $src)

  # -h - change perms of the link
  chmod -h -- $perms $dest ; log-msg -t chmod -- "$perms $dest"
}

##[>] symlinked tree
pushd "$configs/root-ln"

typeset -a repo_files repo_dirs ex repo_files_ex

# 1. get files from git
ex=( **/*.auto.tmpl )
repo_files=( ${(f)$(git ls-files --exclude-standard)} )
repo_dirs=( ${(u)repo_files:h} )
repo_files_ex=( ${repo_files:|ex} )

#[what] 🤖🤖 add every ancestor dir #[why] plain mkdir (no -p) needs each parent made + owned, not just the leaf
typeset -aU repo_dirs_all #[what] 🤖🤖
for dir ( $repo_dirs ) { while [[ $dir == */* ]] { repo_dirs_all+=$dir; dir=$dir:h }; repo_dirs_all+=$dir } #[what] 🤖🤖

# 2. create dirs (parents first), copying owner and file permissions #[what] 🤖🤖
for dir ( ${(o)repo_dirs_all} ) {  #[what] 🤖🤖 (o) sort -> parents before children
  if [[ ! -d /$dir ]] {
    mkdir /$dir; log-msg -t mkdir -- /$dir  #[what] 🤖🤖 no -p
    cp_owner $dir /$dir
    cp_perms $dir /$dir
  }
}

# 3. create links, copying owner and file permissions
for file ( $repo_files_ex ) {
  dest=/$file
  if [[ ${dest:A} != ${file:A} ]] {
    ln -fws ${file:a} $dest ; log-msg -t ln -- $dest
    cp_owner $file $dest
    cp_perms $file $dest
  }
}
popd
##[<] symlinked tree


##[>] copied tree
pushd "$configs/root-cp"

# 1. get files from git
repo_files=( ${(f)$(git ls-files --exclude-standard)} )
repo_dirs=( ${(u)repo_files:h} )
repo_files_ex=( ${repo_files:|ex} )

# 2. create dirs, copying file permissions, apply root ownership
for dir ( $repo_dirs ) {
  if [[ ! -d /$dir ]] {
    mkdir -p /$dir; log-msg -t mkdir -- /$dir
    cp_perms $dir /$dir
  }
}

# 3. copy files if modified; modify perms and ownership if specified
typeset -A perms=(
  /etc/sudoers.d/configs  'root:wheel 0440'
)

for file ( $repo_files_ex ) {
  if { ! cmp -s ${file:a} /$file } {
    cp ${file:a} /$file; log-msg -t cp -- /$file
    if [[ -n ${perms[/$file]} ]] {
      perm=${perms[/$file]}
      chown -- ${perm%% *} /$file; log-msg -t chown -- "${perm%% *} /$file"
      chmod -- ${perm##* } /$file; log-msg -t chmod -- "${perm##* } /$file"
    } else {
      cp_perms $file /$file
    }
  }
}
popd
##[<] copied tree
