#!/bin/zsh
#>[what]
#   1. search for all *.repo.auto.tmpl templates under templates/ and ci/
#   2. render it to the repo path in its render-to: frontmatter
#   --local: also render local templates (*local* in name); off by default
#/[what]

emulate -LR zsh
IFS=
setopt errexit pipefail
autoload -Uz log-msg

##[>] 🤖🤖
zparseopts -D -F -- -local=local || exit 1
configs=${1:-/Users/ko/projects/configs}
local_glob='*local*'
##[<] 🤖🤖

function strip-frontmatter-if-empty {
  local content=$(<&0)
  local -a lines=( "${(@f)content}" ) #[what] @f - split on \n, keep blanks

  local empty_frontmatter=$'---\n{}\n---'
  local head=${(F)lines[1,3]} #[what] F - replace \n with newlines

  if [[ $head == $empty_frontmatter ]] content=${(F)lines[4,-1]}
  print -r -- $content
}

##[>] 🤖🤖
function resolve-at-includes {
  local line
  while IFS= read -r line; do
    if [[ $line == '@'[^[:space:]]* && $line != *[[:space:]]* ]] {
      print -r -- "$(<$configs/${line#@})"
    } else {
      print -r -- $line
    }
  done
}

#[what] autogen header line for $out (arg1), comment syntax by extension
function autogen-header {
  local out=$1 template=$2
  if [[ ${out:e} == md ]] {
    print -r -- "<!-- autogenerated using $template -->"
  } else {
    print -r -- "# autogenerated using $template"
  }
}
##[<] 🤖🤖

function render_template {
  local template=$1
  local render_to

  ##[>] 🤖🤖
  #[what] no frontmatter: render next to the template, sans .repo.auto.tmpl
  if [[ $(head -1 $template) != '---' ]] {
    render_to=${template%.repo.auto.tmpl}
    { autogen-header $render_to $template; gomplate -f $template } > $configs/$render_to
    chmod 0660 $configs/$render_to
    log-msg -t gomplate -- $configs/$render_to
    return
  }

  #[what] read render-to as a list (scalar back-compat via flatten)
  local -a render_tos=( ${(f)"$(yq -f extract '[.render-to] | flatten | .[]' $template)"} )

  #[what] render body once to a temp, fan out per output
  local body=$(mktemp)
  yq -f process 'del(.render-to)' $template \
    | strip-frontmatter-if-empty \
    | gomplate > $body

  for render_to ( $render_tos ) {
    #[what] AGENTS-style outputs inline @-includes; CLAUDE keeps them as links
    autogen-header $render_to $template > $configs/$render_to
    if [[ ${render_to:t} == *AGENTS* ]] {
      resolve-at-includes < $body >> $configs/$render_to
    } else {
      cat $body >> $configs/$render_to
    }
    chmod 0660 $configs/$render_to
    log-msg -t gomplate -- $configs/$render_to
  }
  rm -f $body
  ##[<] 🤖🤖
}

pushd $configs
#[what] . - regular files, D - GLOB_DOT opt (search hidden)
for template ( {templates,ci}/**/*.repo.auto.tmpl(.D) ) {
  #[what] skip local templates unless --local 🤖🤖
  if (( ! $#local )) && [[ ${template:t} == ${~local_glob} ]] continue
  render_template $template
}
popd
