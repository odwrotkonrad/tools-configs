##[>] 🤖🤖
FROM debian:bookworm-slim

ENV GOPATH=/usr/local/go-tools
ENV PATH=/usr/local/go/bin:/usr/local/go-tools/bin:/usr/local/bin:$PATH

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      make git zsh curl ca-certificates clang sudo unzip procps file perl \
 && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/zsh ko \
 && echo 'ko ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/ko

COPY . /opt/ci

RUN install -d -m 0777 "$GOPATH" \
 && GOMODCACHE=/tmp/go-mod GOCACHE=/tmp/go-build \
    zsh -c 'fpath=(/opt/ci/ci/zsh/functions $fpath); source /opt/ci/ci/zsh/scripts/installs/00-ci-deps.zsh build-ci-image' \
 && chmod -R a+rX "$GOPATH" /usr/local/go \
 && rm -rf /tmp/go-mod /tmp/go-build /opt/ci
##[<] 🤖🤖
