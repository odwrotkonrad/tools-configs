set virtualedit=onemore

" Enable mouse support in all modes (normal, visual, insert, command)
set mouse=a

" Yank/paste use the system clipboard by default (the + register)
set clipboard=unnamedplus

" Show line numbers
set number

" (duplicate of the mouse=a above — can be removed)
set mouse=a

" Keep up to 1000 levels of undo
set undolevels=1000

" A tab counts as 2 columns wide
set tabstop=2

" Auto-wrap inserted text
set textwidth=100

" Remember up to 1000 lines of command/search history
set history=1000

" Wrap long lines visually (display only, doesn't insert line breaks)
set wrap

" When wrapping, break at word boundaries instead of mid-word
set linebreak

" Highlight all matches of the last search ('hlsearch')
set hls

" Case-insensitive searching ('ignorecase')
set ic

" cmd + c -> copy
vnoremap <Esc>[99;9u "*y

" Alt+Left / Alt+Right: move by word
nnoremap <M-Left>  b
nnoremap <M-Right> w

" Cmd+Left / Cmd+Right: beginning (first non-blank) / end of line
nnoremap <Esc>[1;9D ^
nnoremap <Esc>[1;9C $

" Alt+Up / Alt+Down: jump 10 lines
nnoremap <M-Up>   10k
nnoremap <M-Down> 10j

" Cmd+Up / Cmd+Down: jump to top / bottom of file
nnoremap <Esc>[1;9A gg
nnoremap <Esc>[1;9B G

" Plain backspace: delete one char back
nnoremap <BS> X

" Alt+Backspace: delete word backward
" NOTE: sequence ^[[127;3u derived from pattern — verify
nnoremap <Esc>[127;3u db

" Cmd+Backspace: delete to start of line
nnoremap <Esc>[127;9u d0

" Cmd+Z: undo
nnoremap <Esc>[122;9u u

" Cmd+Shift+Z: redo
nnoremap Ú <C-r>

" Cmd+S: save file (if modified)
nnoremap <Esc>[115;9u :update<CR>

" Cmd+W: quit, prompting to save if there are unsaved changes
nnoremap <Esc>[119;9u :confirm q<CR>

" Enable persistent undo — undo history is saved to disk and survives
set undofile

" Where to store the undo files.
set undodir=$XDG_STATE_HOME/vim/undo//
