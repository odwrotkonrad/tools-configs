##[>] aws
aws sso login --sso-session ko-org   #[what] authorize the ko-org sso session
aws configure list
aws configure list-profiles
aws s3 ls --profile ko-staging
export AWS_PROFILE=ko-staging        #[what] set default profile to named profile
aws s3 ls s3://ko-backups
##[<] aws

##[>] gcloud - google cloud cli 🤖
gcloud auth login
gcloud auth application-default login
gcloud config configurations list
gcloud config configurations activate main
gcloud config configurations activate staging
gcloud config configurations activate production
gcloud config list
gcloud storage buckets list
gcloud storage objects list 'gs://ko-backups/**'
##[<] gcloud 🤖

##[>] git [what] the stupid content tracker
git stash                       #[what] stash tracked files
git add .
git commit
git push
git push --force-with-lease
git status
git stash pop
git stash show
##[<] git

##[>] azure - azure cli
az login
az account list                                          #[what] list subscriptions
az account set --subscription "Azure subscription 1"     #[what] switch active subscription
az storage container list --account-name backupsko --auth-mode login  #[why] kobackups was taken, storage account names are globally unique
##[<] azure

##[>] defaults [what] access the macOS user defaults system
defaults delete com.apple.dock "autohide"
defaults read com.apple.dock
defaults read | rg --only-matching  'com.apple[.\w]+' - | sort | uniq
defaults find com.apple.dock
defaults write com.apple.dock "autohide" -bool "false"
##[<] defaults

##[>] kitten [what] kitty's CLI utility
kitten themes                   #[what] interactive theme selection
##[<] kitten

##[>] launchctl [what] Interfaces with launchd
#[what] -k - if service is running remove it and start again
launchctl bootstrap gui/$(id -u) $HOME/Library/LaunchAgents/load-defaults-config.plist  #[what] load service
launchctl bootout gui/$(id -u)/load-defaults-config                                         #[what] unload service
launchctl kickstart -k gui/$(id -u)/load-defaults-config                                    #[what] run service
launchctl list                                                                                      #[what] list all services
launchctl print gui/$(id -u)/load-defaults-config                                           #[what] show details of a service
##[<] launchctl

##[>] plutil [what] property list utility
#[what] -p - pretty print
plutil -p  $HOME/Library/LaunchAgents/load-defaults-config.plist                        #[what] print plist
plutil -lint  $HOME/Library/LaunchAgents/load-defaults-config.plist                     #[what] lint plist
plutil -convert json $HOME/Library/LaunchAgents/load-defaults-config.plist              #[what] plist to json
plutil -convert xml1 $HOME/Library/LaunchAgents/load-defaults-config.plist              #[what] plist to xml (from various formats)
##[<] plutil

