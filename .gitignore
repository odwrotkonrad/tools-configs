!root-ln/**/.*

# project-local vscode workspace settings
!.vscode/
!.vscode/settings.json

# exported default config / keybindings of vscode
**/Code/User/.exported/*
!**/Code/User/.exported/.gitkeep

# scratch space for temporary scripts (claude)
.claude/tmp/

# python bytecode cache (repo-local rule so `tree --gitignore` prunes it from docs/data/dirs.yml)
__pycache__/
.pytest_cache/

/root-ln/etc/**/*local*
