!root-ln/**/.*

# project-local vscode workspace settings
!.vscode/
!.vscode/settings.json

# exported default config / keybindings of vscode
**/Code/User/.exported/*
!**/Code/User/.exported/.gitkeep


__pycache__/
.pytest_cache/
**/.mypy_cache/

/root-ln/etc/**/*local*

# rendered packer variables
/ci/local/vm/templates/*.local.pkrvars.hcl

# go binaries built on demand by run-repo-ci-prepare-executables
/ci/go/bin/

# azure cli writes auth state + indexes into its config dir; track only config
/root-ln/Users/ko/.config/azure/*
!/root-ln/Users/ko/.config/azure/config
