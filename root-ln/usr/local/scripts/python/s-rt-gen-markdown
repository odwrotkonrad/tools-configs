#!/usr/bin/env python3.14
"""usage: s-rt-gen-markdown <template>

Render a Jinja markdown template to stdout:

1. read the template at <template>
2. render it injecting included files
3. print the result to stdout

Interfaces with:
- files: template, additional files loaded in the template

Exit Codes:
- 21 render error
- 11 invalid arguments
- 13 template not found
"""

from pathlib import Path
import re
import sys
from typing import ClassVar
from typing import TypedDict

from jinja2 import Environment
from jinja2 import FileSystemLoader
from jinja2 import TemplateError
from jinja2 import select_autoescape
from pydantic import BaseModel
from pydantic import field_validator
from s_rt_scripts_lib import errors as lib_err
from s_rt_scripts_lib import input as lib_ipt
import yaml


# […] 🤖
# […] errors
class Errors(lib_err.Errors):
    """The script's exit-code contract: the `1x` band plus the `2x` domain."""

    RENDER = 21
    MESSAGES = lib_err.Errors.MESSAGES | {
        RENDER: "render failed: {path}: {reason}"
    }


# [⫶] errors


# […] types
type TemplatePathStr = str
type RelativeIncludePathStr = str
type RenderedTemplateStr = str
type Body = str
"""file content after the frontmatter header."""
type ReferenceNoteStr = str


class Frontmatter(TypedDict, total=False):
    """YAML mapping parsed from a file's `---` header."""

    title: str
    description: str
    references: dict[RelativeIncludePathStr, ReferenceNoteStr]


# [⫶] types


# […] contract
class Action(lib_ipt.BaseAction):
    """The actions the script supports: the base actions plus RENDER."""

    RENDER = "render"


class Arguments(BaseModel):
    """The validated positional arguments."""

    template: TemplatePathStr

    @field_validator("template")
    @classmethod
    def template_is_file(cls, value: TemplatePathStr) -> TemplatePathStr:
        """Reject a template path that is not an existing file."""
        if not Path(value).is_file():
            raise ValueError(lib_err.Error(Errors.FILE_NOT_FOUND, path=value))
        return value


class Parameters(lib_ipt.BaseParameters):
    """The validated invocation: arguments plus the base options and grammar."""

    arguments: Arguments
    SYNOPSIS: ClassVar[lib_ipt.Synopsis] = (
        lib_ipt.BASE_SCRIPT_SYNOPSIS
        | lib_ipt.Synopsis(
            [lib_ipt.Pattern(options=set(), args=(1, 1), action=Action.RENDER)]
        )
    )


# [⫶] contract


# […] implementation
class Attrs(dict):
    """Dict with attribute access; nested mappings wrap recursively."""

    def __getattr__(self, name) -> object:
        """Return the item `name`, wrapping a nested mapping as Attrs."""
        try:
            value = self[name]
        except KeyError as exc:
            raise AttributeError(name) from exc
        return Attrs(value) if isinstance(value, dict) else value


class Document:
    """A parsed template: its frontmatter as Attrs and its body content."""

    def __init__(self, frontmatter: Frontmatter, content: Body) -> None:
        """Wrap the parsed frontmatter for attribute access; keep the body."""
        self.frontmatter = Attrs(frontmatter or {})
        self.content = content


def split_frontmatter(text: Body) -> tuple[Frontmatter, Body]:
    """Split a leading `---`-delimited YAML header from the body content."""
    match = re.match(r"\A---\n(.*?)\n---\n?(.*)\Z", text, re.DOTALL)
    if not match:
        return {}, text
    return yaml.safe_load(match.group(1)) or {}, match.group(2)


def loader(root: Path):
    """Return a `load(rel)` template global reading files relative to `root`."""

    def load(rel: RelativeIncludePathStr) -> Document:
        """Read `rel` under `root` and parse it into a Document.

        Interfaces with:
          - files: template, additional files loaded in the template
        """
        return Document(*split_frontmatter((root / rel).read_text()))

    return load


def render(
    template: TemplatePathStr,
) -> tuple[RenderedTemplateStr | None, lib_err.Error | None]:
    """Render the Jinja template at `template`, returning ERR_RENDER on failure.

    Interfaces with:
      - files: template, additional files loaded in the template
    """
    path = Path(template)
    env = Environment(
        loader=FileSystemLoader(path.parent),
        autoescape=select_autoescape(default=False),
        keep_trailing_newline=True,
        trim_blocks=True,
        lstrip_blocks=True,
    )
    env.globals |= {"load": loader(path.parent)}
    try:
        return env.get_template(path.name).render(), None
    except (TemplateError, OSError, yaml.YAMLError) as exc:
        return None, lib_err.Error(Errors.RENDER, path=template, reason=exc)


# [⫶] implementation


# […] main
def main(
    action: Action, config: None, params: Parameters
) -> tuple[str | None, lib_err.Error | None]:
    """[≟] Dispatch the resolved action to its handler."""
    match action:
        case Action.USAGE:
            return lib_ipt.usage(__doc__), None
        case Action.SCHEMA:
            return lib_ipt.schema(Parameters), None
        case Action.ABORT:
            return None, params
        case Action.RENDER:
            return render(params.arguments.template)


if __name__ == "__main__":
    out, error = main(*lib_ipt.validate_input(Parameters, sys.argv[1:]))
    if error:
        print(Errors.message(error), file=sys.stderr)
        sys.exit(error.code)
    print(out, end="")
# [⫶] main
