#!/usr/local/bin/python3.14
"""usage: s-rt-op-get <service> [container] [field]

Read 1Password secrets from the custom registry (service -> container -> field
-> env var), merged from /etc/custom and ~/.config/custom secrets.yml.

Prints "var=value" for a mapped field, or the raw value when unmapped.
Narrow output with an optional container and field.

exit: 2 args · 10 no config · 11 service · 12 container · 13 field · 1 op read
"""

import os
import subprocess
import sys
from pathlib import Path

import yaml

XDG = os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")
CONFIGS = [os.environ.get("AUTH_ETC_CONFIG", "/etc/custom/secrets.yml"), f"{XDG}/custom/secrets.yml"]

ERR_ARGS = 2
ERR_CONFIG_NOT_FOUND = 10
ERR_NO_SERVICE = 11
ERR_NO_CONTAINER = 12
ERR_NO_FIELD = 13
ERR_OP = 1


def merge(base, over):
    for key, value in over.items():
        if isinstance(value, dict) and isinstance(base.get(key), dict):
            merge(base[key], value)
        else:
            base[key] = value
    return base


def op_read(ref):
    res = subprocess.run(["op", "read", ref], capture_output=True, text=True)
    return res.stdout.strip() if not res.returncode else sys.exit(ERR_OP)


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__, end="")
        sys.exit(0)
    service, *rest = args or sys.exit(ERR_ARGS)
    want_container, want_field = (rest + [None, None])[:2]

    if not (paths := [p for p in CONFIGS if Path(p).is_file()]):
        sys.exit(ERR_CONFIG_NOT_FOUND)
    cfg = {}
    for path in paths:
        merge(cfg, yaml.safe_load(Path(path).read_text()) or {})

    vault = cfg.get("defaults", {}).get("vault", "Personal")
    if (containers := (cfg.get("services") or {}).get(service)) is None:
        sys.exit(ERR_NO_SERVICE)
    if want_container and want_container not in containers:
        sys.exit(ERR_NO_CONTAINER)
    if want_field and want_field not in (containers.get(want_container) or {}):
        sys.exit(ERR_NO_FIELD)

    for container, fields in containers.items():
        if want_container and container != want_container:
            continue
        for field, var in (fields or {}).items():
            if want_field and field != want_field:
                continue
            value = op_read(f"op://{vault}/{container}/{field}")
            print(f"{var}={value}" if var else value)


if __name__ == "__main__":
    main()
