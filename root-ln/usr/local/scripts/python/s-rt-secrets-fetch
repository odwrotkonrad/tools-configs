#!/usr/local/bin/python3.14
"""usage: s-rt-secrets-fetch <service> [container] [field]

Read 1Password secrets from the custom registry (service -> container -> field
-> env var), merged from /etc/custom and ~/.config/custom secrets.yml.

Prints "var=value" for a mapped field, or the raw value when unmapped.
Narrow output with an optional container and field.

exit: 2 args · 10 no config · 11 bad config · 12 not found · 13 op read
"""

import os
from pathlib import Path
import subprocess
import sys

from pydantic import BaseModel
from pydantic import Field
from s_rt_scripts_lib import errors as err
from s_rt_scripts_lib.config import load_merged

# […] constants
XDG = os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")
CONFIGS = [
    os.environ.get("AUTH_ETC_CONFIG", "/etc/custom/secrets.yml"),
    f"{XDG}/custom/secrets.yml",
]

ERR_OP = 13
# [⫶]


# […] schema
type EnvVar = str | None
type Container = dict[str, EnvVar]
type Service = dict[str, Container]


class Defaults(BaseModel):
    vault: str = "Personal"


class Config(BaseModel):
    defaults: Defaults = Field(default_factory=Defaults)
    services: dict[str, Service] = {}

    def select(self, service, want_container, want_field):
        if (containers := self.services.get(service)) is None:
            sys.exit(err.ERR_CONFIG_LOOKUP)
        if want_container and want_container not in containers:
            sys.exit(err.ERR_CONFIG_LOOKUP)
        if want_field and want_field not in containers.get(want_container, {}):
            sys.exit(err.ERR_CONFIG_LOOKUP)
        for container, fields in containers.items():
            if want_container in (None, container):
                for field, var in fields.items():
                    if want_field in (None, field):
                        yield container, field, var


# [⫶]


def op_read(ref):
    res = subprocess.run(["op", "read", ref], capture_output=True, text=True)
    if res.returncode:
        sys.exit(ERR_OP)
    return res.stdout.strip()


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__, end="")
        sys.exit(0)
    if not args or len(args) > 3:
        sys.exit(err.ERR_ARGS)
    service, container, field = (args + [None, None])[:3]

    cfg = load_merged(CONFIGS, Config)
    vault = cfg.defaults.vault
    for sel_container, sel_field, var in cfg.select(service, container, field):
        value = op_read(f"op://{vault}/{sel_container}/{sel_field}")
        print(f"{var}={value}" if var else value)


if __name__ == "__main__":
    main()
