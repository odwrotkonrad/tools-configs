#!/usr/bin/env python3.14
"""usage: s-rt-get-term-open-files-with <any|vscode|kitty>

Print `<ext>=<opener>`(file ext=program to run) suffix-alias  lines for the terminal:

1. read the terminal config and the cached language→extensions data
2. expand each opener rule's language categories into file extensions
3. print `<ext>=<opener>` lines to stdout

Examples:

    $ s-rt-get-term-open-files-with any|vscode|kitty
    $ s-rt-get-term-open-files-with --help

Upstream Interfaces with:
- `$ alias -s` — intended consumer of the printed lines (zsh suffix aliases)

Downstream Interfaces with:
- files: term-open-files-with.yml, the language→extensions data cache
- https://raw.githubusercontent.com/github-linguist/linguist — GitHub's
  language→extensions data (languages.yml)

Exit Codes:
- 11 invalid arguments
- 12 invalid config
- 13 config not found
- 14 language→extensions data fetch failed (network)
"""

from collections import defaultdict
import os
from pathlib import Path
import sys
from typing import ClassVar

from pydantic import BaseModel
from pydantic import field_validator
import requests
from s_rt_scripts_lib import config as lib_cfg
from s_rt_scripts_lib import errors as lib_err
from s_rt_scripts_lib import input as lib_input
from s_rt_scripts_lib import parameters as lib_param
import yaml

# […] 🤖🤖
CACHE_DIR = Path(
    os.environ.get(
        "LINGUIST_CACHE_DIR", "/var/custom/cache/s-rt-get-term-open-files-with"
    )
)
LANGUAGES_URL = (
    "https://raw.githubusercontent.com/github-linguist/linguist"
    "/master/lib/linguist/languages.yml"
)


# […] types
type LanguageCategoryStr = str
"""a language family bucket (e.g. `programming`, `prose`)."""

type FileExtensionStr = str
"""a lowercased extension without the dot (e.g. `py`, `json`)."""

type TerminalStr = str
"""a supported terminal name (e.g. `vscode`, `kitty`)."""

type OpenerStr = str
"""a command that opens a file (e.g. `vim`, `code -r`)."""

type SectionNameStr = str
"""a config section: a terminal name or the shared `any` base."""

type ByTypeDict = dict[LanguageCategoryStr, list[FileExtensionStr]]
"""the {language-category: [ext, ...]} map derived from linguist data."""

type AliasesDict = dict[FileExtensionStr, OpenerStr]
"""the {ext: opener} suffix-alias map for a terminal."""


class OpenerRule(BaseModel):
    """One opener rule: the opener command and the language categories it covers."""

    opener: OpenerStr | None = None
    types: list[LanguageCategoryStr] = []


type SectionsDict = dict[SectionNameStr, list[OpenerRule]]
"""the terminal config mapping: each section -> its opener rules."""
# [⫶] types


# […] contract
class Action(lib_param.BaseAction):
    GET_OPEN_FILES_WITH = "get-open-files-with"


class Config(lib_cfg.BaseConfig):
    """The terminal config read from /etc/custom: section -> opener rules."""

    NAME: ClassVar[str] = "term-open-files-with.yml"
    data: SectionsDict = {}


class Arguments(BaseModel):
    TERMINALS: ClassVar[tuple[str, ...]] = ("any", "vscode", "kitty")
    terminal: TerminalStr

    @field_validator("terminal")
    @classmethod
    def terminal_known(cls, value: TerminalStr) -> TerminalStr:
        """Reject a terminal name outside the supported set."""
        if value not in cls.TERMINALS:
            raise lib_err.Error(lib_err.Errors.ARGS, args=[value])
        return value


class Parameters(lib_param.BaseParameters):
    arguments: Arguments | None = None
    ARGUMENTS: ClassVar[type[Arguments]] = Arguments
    SYNOPSIS: ClassVar[list[lib_param.Pattern]] = [
        *lib_param.BaseParameters.SYNOPSIS,
        lib_param.Pattern(
            options=set(), args=(1, 1), action=Action.GET_OPEN_FILES_WITH
        ),
    ]


class Input(lib_input.BaseInput):
    PARAMS: ClassVar[type[Parameters]] = Parameters
    CONFIG: ClassVar[type[Config]] = Config

    params: Parameters
    config: Config | None = None


# [⫶] contract


# […] implementation
def fetch_languages() -> tuple[str | None, lib_err.Error | None]:
    """Return the language→extensions data, downloading to the cache if absent.

    Interfaces with:
      - files: the language→extensions data cache
      - https://raw.githubusercontent.com/github-linguist/linguist
    """
    cached = CACHE_DIR / "languages.yml"
    if not cached.is_file():
        try:
            res = requests.get(LANGUAGES_URL, timeout=30)
            res.raise_for_status()
        except requests.RequestException:
            return None, lib_err.Error(
                lib_err.Errors.NETWORK, url=LANGUAGES_URL
            )
        cached.parent.mkdir(parents=True, exist_ok=True)
        cached.write_text(res.text)
        cached.chmod(0o644)
    return cached.read_text(), None


def type_extensions() -> tuple[ByTypeDict | None, lib_err.Error | None]:
    """Return the {language-category: [ext, ...]} map from the cached data."""
    text, error = fetch_languages()
    if error is not None:
        return None, error
    by_type = defaultdict(set)
    for lang in (yaml.safe_load(text) or {}).values():
        kind = (lang or {}).get("type")
        if kind:
            by_type[kind].update(
                e.lower().lstrip(".") for e in lang.get("extensions") or []
            )
    return {kind: sorted(exts) for kind, exts in by_type.items()}, None


def get_extensions_for_terminal(
    sections: SectionsDict, by_type: ByTypeDict, name: SectionNameStr
) -> AliasesDict:
    """Return {ext: opener} for one config section; a later entry wins on collision."""
    aliases: AliasesDict = {}
    for rule in sections.get(name) or []:
        for kind in rule.types if rule.opener else []:
            for ext in by_type.get(kind) or []:
                aliases[ext] = rule.opener
    return aliases


def get_open_files_with(
    terminal: TerminalStr, sections: SectionsDict
) -> tuple[str | None, lib_err.Error | None]:
    """Render `<ext>=<opener>` lines for the terminal, joined by newlines.

    Interfaces with:
      - files: the language→extensions data cache
      - https://raw.githubusercontent.com/github-linguist/linguist
    """
    by_type, error = type_extensions()
    if error is not None:
        return None, error
    aliases = {
        **get_extensions_for_terminal(sections, by_type, "any"),
        **get_extensions_for_terminal(sections, by_type, terminal),
    }
    return "\n".join(f"{ext}={opener}" for ext, opener in aliases.items()), None


# [⫶] implementation


# […] main
def main(
    input: Input,
) -> tuple[str | None, lib_err.Error | None]:
    """[≟] Dispatch the resolved action to its handler."""
    match input.params.action:
        case Action.USAGE:
            return lib_input.usage(__doc__), None
        case Action.GET_OPEN_FILES_WITH:
            return get_open_files_with(
                input.params.arguments.terminal, input.config.data
            )


if __name__ == "__main__":
    input, error = Input.validate_input(sys.argv[1:])
    if not error:
        out, error = main(input)
    if error:
        print(lib_err.Errors.message(error), file=sys.stderr)
        sys.exit(error.code)
    print(out)
# [⫶] main
