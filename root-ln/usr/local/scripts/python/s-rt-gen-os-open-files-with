#!/usr/local/bin/python3.14
"""usage: s-rt-gen-os-open-files-with [config]

Print `<bundle> <uti> <role>` lines for duti. Example:

    s-rt-gen-os-open-files-with | while read -r bundle uti role; do
      duti -s "$bundle" "$uti" "$role"
    done

exit: 11 args · 13 no config · 12 bad config
"""

from pathlib import Path
import sys

from pydantic import RootModel
from s_rt_scripts_lib import errors as err
from s_rt_scripts_lib.config import load_yaml

# […] constants
DEFAULT_CONFIG = "/etc/custom/os-open-files-with.yml"
# [⫶]


# […] schema
type Uti = str
type Role = str
type Application = str
type Roles = dict[Role, list[Uti]]


class Config(RootModel[dict[Application, Roles]]):
    pass


# [⫶]


def handler_lines(cfg):
    """Yield `<bundle> <uti> <role>` for each uti under each app's role keys."""
    for bundle, roles in cfg.root.items():
        for role, utis in roles.items():
            for uti in utis:
                yield f"{bundle} {uti} {role}"


def main():
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__, end="")
        sys.exit(0)
    if len(args) > 1:
        sys.exit(err.ERR_ARGS)
    path = Path(args[0]) if args else Path(DEFAULT_CONFIG)

    for line in handler_lines(load_yaml(path, Config)):
        print(line)


if __name__ == "__main__":
    main()
