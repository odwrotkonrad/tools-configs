#!/usr/bin/env python3.14
"""usage: s-rt-generate-tree
       s-rt-generate-tree --check <file>

Print the plain directory tree of the cwd repo's tracked files:

1. read the tracked paths from the git index at the cwd
2. drop each path's file leaf and nest the remaining dirs
3. print the sorted tree, 2-space indented, one dir per line

With `--check <file>`, compare <file> against the freshly generated tree:
exit 0 on match, or print a unified diff to stderr and exit 22 on mismatch.

Examples:

    $ s-rt-generate-tree
    $ s-rt-generate-tree --check docs/data/dirs.gen.md
    $ s-rt-generate-tree --help

Upstream Interfaces with:
- `> <file>` — intended consumer of the printed tree (e.g. docs/data/dirs.gen.md)

Downstream Interfaces with:
- git repo at the cwd — its index supplies the tracked paths

Exit Codes:
- 21 cwd is not a git repo
- 22 --check file differs from the generated tree
- 11 invalid arguments
- 13 --check file not found
"""

import difflib
from pathlib import Path
import sys
from typing import ClassVar

from pydantic import BaseModel
from pydantic import field_validator
import pygit2
from s_rt_scripts_lib import errors as lib_err
from s_rt_scripts_lib import input as lib_input
from s_rt_scripts_lib import options as lib_options
from s_rt_scripts_lib import parameters as lib_param


