#!/usr/bin/env zsh
#>[≟]
#   LLM driven change request (MR/PR) generation
#   Usage: <extra-instructions-on-stdin> | s-rt-llm-git-mr-text-suggest [range] [template-file]
#   extra-instructions: optional, read from stdin when piped.
#   template-file: optional, defaults to ./templates-llm/git-mr-text-suggest.tmpl.md
#   Upstream: git-mr skill. Downstream: net diff, commits as secondary context.
#   Out: { "title": ..., "description": ... }.
#/[≟]

set -e


#[…] script input
typeset -A script_input=(
  instructions_runtime "$([[ -t 0 ]] || cat)"

  range "${1:-main..HEAD}"
  template_file "${2:-${0:A:h}/templates-llm/git-mr-text-suggest.tmpl.md}"
)
#[⫶] script input


#[…] template input 🤖
typeset -A template_input=(
  RANGE_COMMITS "$script_input[range]"
  RANGE_DIFF "${script_input[range]/../...}"
  COMMITS "$(git log --reverse --format='%h %s' "$script_input[range]")"
  NET_DIFF "$(git diff "${script_input[range]/../...}")"
  INSTRUCTIONS_RUNTIME "$script_input[instructions_runtime]"
)
#[⫶] template input 🤖

# if there are no changes return
[[ -n $template_input[COMMITS] ]] || { echo "error: no commits in $script_input[range]" >&2; exit 1 }


#[…] fill template 🤖
prompt=$(
  for k v in "${(@kv)template_input}"; do export "$k"="$v"; done
  gomplate \
    --plugin stripmd="${0:A:h}/s-rt-read-markdown" \
    -f "$script_input[template_file]"
)
#[⫶] fill template 🤖


#[…] claude invocation
export ANTHROPIC_MODEL=haiku

schema='{
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": ["title", "description"],
  "additionalProperties": false
}'

<<< "$prompt" s-rt-llm-claude "$schema"
#[⫶] claude invocation
