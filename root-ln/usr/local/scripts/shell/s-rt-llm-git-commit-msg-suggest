#!/usr/bin/env zsh
#>[≟]
#   LLM driven commit message generation
#   Usage: <extra-instructions-on-stdin> | s-rt-llm-git-commit-msg-suggest
#   extra-instructions: optional, read from stdin when piped.
#   Upstream: git-commit skill. Prompt Template: ./templates-llm/git-commit-msg-suggest.md
#   Out: { "subject": ..., "description": ... }.
#/[≟]

set -e


#[…] script input
typeset -A script_input=(
  instructions_runtime "$([[ -t 0 ]] || cat)"
)
#[⫶] script input


#[……] template input
typeset -A template_input=(
  instructions_core ""
  instructions_prose ""
  instructions_runtime ""

  commit_template ""
  recent_commits ""
  staged_diff ""
)

#[…] template input prep 🤖
template_input[staged_diff]=$(git diff --cached)
[[ -n $template_input[staged_diff] ]] || { echo "error: nothing staged" >&2; exit 1 }

template=$(git config --get commit.template)
template=${template/#\~/$HOME}
[[ -n $template && -f $template ]] && template_input[commit_template]=$(cat "$template")

template_input[recent_commits]=$(git log -3 --format='--- %h%n%B')

template_input[instructions_core]=$(s-rt-read-markdown --strip-comments "${0:A:h}/templates-llm/git-commit-msg-suggest.md")
template_input[instructions_prose]=$(s-rt-read-markdown --strip-frontmatter --strip-comments ~/.config/claude/rules/docs/prose.md)
template_input[instructions_runtime]=${script_input[instructions_runtime]:+"## IMPORTANT
$script_input[instructions_runtime]"}
#[⫶] template input prep 🤖
#[⫶⫶] template input


#[…] fill template
prompt="## Commit Template
$template_input[commit_template]

## Recent Commits (full message, last 3)
$template_input[recent_commits]

## Staged Diff
$template_input[staged_diff]

$template_input[instructions_prose]

$template_input[instructions_core]

$template_input[instructions_runtime]
"
#[⫶] fill template


#[…] claude invocation
export ANTHROPIC_MODEL=opus

schema='{
  "type": "object",
  "properties": {
    "subject": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": ["subject", "description"],
  "additionalProperties": false
}'

<<< "$prompt" s-rt-llm-claude "$schema"
#[⫶] claude invocation
