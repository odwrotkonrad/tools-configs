#!/usr/bin/env zsh
#>[≟]
#   LLM driven commit message generation
#   Usage: <extra-instructions-on-stdin> | s-rt-llm-git-commit-msg-suggest [template-file]
#   extra-instructions: optional, read from stdin when piped.
#   template-file: optional, defaults to ./templates-llm/git-commit-msg-suggest.tmpl.md
#   Upstream: git-commit skill. Out: { "subject": ..., "description": ... }.
#/[≟]

set -e


#[…] script input
typeset -A script_input=(
  instructions_runtime "$([[ -t 0 ]] || cat)"

  template_file "${1:-${0:A:h}/templates-llm/git-commit-msg-suggest.tmpl.md}"
)
#[⫶] script input


#[…] template input 🤖
get_commit_template() {
  local f=$(git config --get commit.template); f=${f/#\~/$HOME}
  [[ -n $f && -f $f ]] && cat "$f"
}

typeset -A template_input=(
  COMMIT_TEMPLATE "$(get_commit_template)"
  RECENT_COMMITS "$(git log -3 --format='--- %h%n%B')"
  STAGED_DIFF "$(git diff --cached)"
  INSTRUCTIONS_RUNTIME "$script_input[instructions_runtime]"
)
#[⫶] template input 🤖


# if there are no changes return
[[ -n $template_input[STAGED_DIFF] ]] || { echo "error: nothing staged" >&2; exit 1 }

#[…] fill template 🤖
prompt=$(
  for k v in "${(@kv)template_input}"; do export "$k"="$v"; done
  gomplate \
    --plugin stripmd="${0:A:h}/s-rt-read-markdown" \
    -f "$script_input[template_file]"
)
#[⫶] fill template 🤖


#[…] claude invocation
export ANTHROPIC_MODEL=haiku

schema='{
  "type": "object",
  "properties": {
    "subject": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": ["subject", "description"],
  "additionalProperties": false
}'

<<< "$prompt" s-rt-llm-claude "$schema"
#[⫶] claude invocation
