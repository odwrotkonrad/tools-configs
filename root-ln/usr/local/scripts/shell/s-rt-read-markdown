#!/usr/bin/env zsh
#>[≟]
#   Read a markdown file, optionally stripping YAML frontmatter and/or comments.
#   Usage: s-rt-read-markdown [--strip-frontmatter] [--strip-comments] [--increment-heading-levels] <file>
#   --strip-frontmatter: drop a leading --- ... --- block.
#   --strip-comments: drop <!-- ... --> blocks (incl. multi-line).
#   --increment-heading-levels [n]: demote every ATX heading n levels (default 1), capped at 6.
#   Upstream: s-rt-llm-git-* scripts. Downstream: <file>. Out: file content on stdout.
#/[≟]

#[…] 🤖🤖🤖
emulate -LR zsh
setopt err_return

strip_frontmatter=0 strip_comments=0 increment_heading_levels=0
while [[ $1 == --* ]]; do
  case $1 in
    --strip-frontmatter) strip_frontmatter=1 ;;
    --strip-comments) strip_comments=1 ;;
    --increment-heading-levels) increment_heading_levels=1; [[ $2 == <-> ]] && { increment_heading_levels=$2; shift } ;;
    *) print -u2 "s-rt-read-markdown: unknown option $1"; exit 1 ;;
  esac
  shift
done

file=$1
content=$(<"$file")

if (( strip_frontmatter )); then
  content=$(print -r -- "$content" | sed '1{/^---$/!q;};1,/^---$/d')
fi

if (( strip_comments )); then
  content=$(print -r -- "$content" | perl -0pe 's/<!--.*?-->\n?//gs')
fi

if (( increment_heading_levels )); then
  content=$(print -r -- "$content" | perl -spe 's{^(#{1,6})(?= )}{my $l = length($1) + $n; "#" x ($l > 6 ? 6 : $l)}e' -- -n=$increment_heading_levels)
fi

print -r -- "$content"
#[⫶] 🤖🤖🤖
