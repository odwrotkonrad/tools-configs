#!/bin/zsh
#>[≟]
#   script wrapper: pretty-print a header and terminator around the command
#[∵] when running commands one after another, distinguishes which output is whose
#/[≟]

emulate -LR zsh

#[…] 🤖🤖 label: command basename (skip leading sudo) + the last non-config option
local cmd=$1
[[ $cmd == sudo ]] && cmd=$2
local label=${cmd:t}
local opts=(${${(M)argv:#-*}:#*config*})
[[ -n ${opts[-1]} ]] && label+=" ${opts[-1]}"
#[⫶]

print-with title "BEGIN ${label}"
"$@"; rc=$?
print-with title "END ${label}"
exit $rc
