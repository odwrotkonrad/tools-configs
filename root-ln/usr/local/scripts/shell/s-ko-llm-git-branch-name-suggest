#!/usr/bin/env zsh
#>[≟]
#   LLM driven branch name generation
#   Usage: s-ko-llm-git-branch-name-suggest [range] [extra-instructions] [include-unstaged=1]
#   include-unstaged: 1 add tracked unstaged changes, 0 staged only. Never untracked.
#   Upstream: git-commit, git-mr skills. Downstream: git subjects + diffs.
#   Prompt Template: ./templates-llm/s-ko-llm-git-branch-name-suggest.md
#   Out: { "name": ... }.
#/[≟]

set -e


#[…] args
range=${1:-main..HEAD}
additional_runtime_instructions=${2:-}
include_unstaged=${3:-1}
#[⫶] args


#[…] template parameters
typeset -A template_params=(
  commits_log_short ""
  changes ""
  changes_stats ""
)


template_params[commits_log_short]=$(git log --reverse --format='%s' "$range")

if [[ $include_unstaged == 1 ]]; then
  template_params[changes]=$(git diff HEAD)
  template_params[changes_stats]=$(git diff --stat HEAD)
else
  template_params[changes]=$(git diff --cached)
  template_params[changes_stats]=$(git diff --stat --cached)
fi

if [[ -z $template_params[commits_log_short] && -z $template_params[changes] ]]; then
  jq -nc --arg n "tmp/scratch-$(date +%Y%m%d-%H%M%S)" '{name:$n}'
  exit 0
fi
#[⫶] template parameters


#[…] fill template
instructions=$(cat "${0:A:h}/templates-llm/s-ko-llm-git-branch-name-suggest.md")

prompt="$instructions

[commit-subjects ($range)]
$template_params[commits_log_short]

[changes-stats]
$template_params[changes_stats]

[changes]
$template_params[changes]

[additional-runtime-instructions]
$additional_runtime_instructions"
#[⫶] fill template


#[…] claude invocation
export ANTHROPIC_MODEL=haiku

schema='{
  "type": "object",
  "properties": {
    "name": { "type": "string" }
  },
  "required": ["name"],
  "additionalProperties": false
}'

print -r -- "$prompt" | s-ko-llm-claude "$schema"
#[⫶] claude invocation
