#!/usr/bin/env zsh
#>[≟]
#   LLM driven commit message generation
#   Usage: s-ko-llm-git-commit-msg-suggest [extra-instructions]
#   Upstream: git-commit skill. Prompt Template: ./templates-llm/s-ko-llm-git-commit-msg-suggest.md
#   Out: { "subject": ..., "description": ... }.
#/[≟]

#[…] 🤖🤖
set -e


#[…] args
additional_runtime_instructions=${1:-}
#[⫶] args


#[…] template parameters
typeset -A template_params=(
  commit_template ""
  recent_commits ""
  staged_diff ""
)


template_params[staged_diff]=$(git diff --cached)
[[ -n $template_params[staged_diff] ]] || { echo "error: nothing staged" >&2; exit 1 }

template=$(git config --get commit.template)
template=${template/#\~/$HOME}
[[ -n $template && -f $template ]] && template_params[commit_template]=$(cat "$template")

template_params[recent_commits]=$(git log -3 --format='--- %h%n%B')
#[⫶] template parameters


#[…] fill template
instructions=$(cat "${0:A:h}/templates-llm/s-ko-llm-git-commit-msg-suggest.md")

prompt="$instructions

[commit-template]
$template_params[commit_template]

[recent-commits (full message, last 3)]
$template_params[recent_commits]

[additional-runtime-instructions]
$additional_runtime_instructions

[staged-diff]
$template_params[staged_diff]"
#[⫶] fill template


#[…] claude invocation
export ANTHROPIC_MODEL=opus

schema='{
  "type": "object",
  "properties": {
    "subject": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": ["subject", "description"],
  "additionalProperties": false
}'

print -r -- "$prompt" | s-ko-llm-claude "$schema"
#[⫶] claude invocation
#[⫶] 🤖🤖
