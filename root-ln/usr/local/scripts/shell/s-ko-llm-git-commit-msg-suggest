#!/usr/bin/env zsh
#>[≟]
#   Generate a conventional commit message from the staged diff via claude -p.
#   Upstream: the git-commit skill, after it stages the authored changes.
#   Downstream: git diff --cached, and the commit-template for type/scope rules.
#   $1 (optional): additional runtime instructions to steer emphasis and wording.
#
#   Runs claude headless in its own context (no session history), so the
#   message describes only the staged diff, never the conversation.
#   Craft guide: ~/.config/claude/prompts/s-ko-llm-git-commit-msg-suggest.md
#   Output: JSON object { "subject": ..., "description": ... }.
#/[≟]

#[…] 🤖🤖
set -e

additional_runtime_instructions=${1:-}

instructions=$(cat "$HOME/.config/claude/prompts/s-ko-llm-git-commit-msg-suggest.md")

schema='{"type":"object","properties":{"subject":{"type":"string"},"description":{"type":"string"}},"required":["subject","description"],"additionalProperties":false}'

diff=$(git diff --cached)
[[ -n $diff ]] || { echo "error: nothing staged" >&2; exit 1 }

template=$(git config --get commit.template)
template=${template/#\~/$HOME}
templatetext=""
[[ -n $template && -f $template ]] && templatetext=$(cat "$template")

recent=$(git log -3 --format='--- %h%n%B')

print -r -- "$instructions

[commit-template]
$templatetext

[recent-commits (full message, last 3)]
$recent

[additional-runtime-instructions]
$additional_runtime_instructions

[staged-diff]
$diff" | claude -p --model opus --system-prompt '' \
  --output-format json --json-schema "$schema" | jq '.structured_output'
#[⫶] 🤖🤖
