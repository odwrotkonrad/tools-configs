#!/bin/sh
#>[≟]
#   reload running service launchagents and launchdaemons
#   kickstart each loaded d-ko-* (agents) / d-rt-* (daemons) in its domain, bootstrap if absent
#   agents -> gui/<uid> (user) · daemons -> system (root, via sudo)
#/[≟]

set -e

reload() {
	domain="$1"
	runner="$2"
	shift 2
	for plist in "$@"; do
		[ -e "$plist" ] || continue
		label="$(basename "$plist" .plist)"
		echo "reloading $domain/$label"
		if $runner launchctl print "$domain/$label" >/dev/null 2>&1; then
			$runner launchctl kickstart -k "$domain/$label"
		else
			$runner launchctl bootstrap "$domain" "$plist"
		fi
	done
}

#[…] user agents
reload "gui/$(id -u)" "" "$HOME"/Library/LaunchAgents/d-ko-*.plist
#[⫶] user agents

#[…] root daemons
reload system sudo /Library/LaunchDaemons/d-rt-*.plist
#[⫶] root daemons
