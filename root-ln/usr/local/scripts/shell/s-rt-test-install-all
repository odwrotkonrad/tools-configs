#!/bin/zsh
#>[≟]
#   In-VM test for s-rt-install-all: run `make run-host-install-all` as user ko,
#   then verify key binaries resolve in ko's login shell. Assumes a prepared VM
#   (user ko, prereqs, tree synced to $configs_dir). Runnable standalone in-VM.
#
#     s-rt-test-install-all [configs-dir]   # default /Users/ko/projects/configs
#/[≟]

emulate -LR zsh
setopt errexit pipefail
autoload -Uz log-msg

#[……] 🤖🤖🤖
#[…] config
typeset configs_dir=${1:-/Users/ko/projects/configs}
typeset -a verify_bins=( brew asdf aws gcloud kitty jaeger otelcol prometheus ollama )
#[⫶]

#[…] install
cd $configs_dir
#[≟] --set-home: HOME=/Users/ko #[∵] brew/asdf caches resolve from $HOME, not admins
log-msg -t test-install-all -- "run-host-install-all"
sudo -u ko --set-home make run-host-install-all
#[⫶]

#[…] verify binaries resolve in ko's login shell
log-msg -t test-install-all -- "verifying binaries"
typeset fail=0 b
for b in $verify_bins; {
  if { sudo -u ko -i command -v $b >/dev/null 2>&1 } { print "ok   $b" } else { print "MISS $b"; fail=1 }
}
exit $fail
#[⫶]
#[⫶⫶] 🤖🤖🤖
