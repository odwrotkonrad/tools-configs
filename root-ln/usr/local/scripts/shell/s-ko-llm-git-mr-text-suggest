#!/usr/bin/env zsh
#>[≟]
#   LLM driven change request (MR/PR) generation
#   Usage: s-ko-llm-git-mr-text-suggest [range] [extra-instructions]
#   Upstream: git-mr skill. Downstream: net diff, commits as secondary context.
#   Prompt Template: ./templates-llm/s-ko-llm-git-mr-text-suggest.md
#   Out: { "title": ..., "description": ... }.
#/[≟]

#[…] 🤖🤖
set -e


#[…] args
range=${1:-main..HEAD}
additional_runtime_instructions=${2:-}
#[⫶] args


#[…] template parameters
typeset -A template_params=(
  net_diff ""
  commits ""
)


template_params[commits]=$(git log --reverse --format='%h %s' "$range")
[[ -n $template_params[commits] ]] || { echo "error: no commits in $range" >&2; exit 1 }

template_params[net_diff]=$(git diff "${range/../...}")
#[⫶] template parameters


#[…] fill template
instructions=$(cat "${0:A:h}/templates-llm/s-ko-llm-git-mr-text-suggest.md")

prompt="$instructions

[net-diff (${range/../...}) — source of truth, describe only what this shows]
$template_params[net_diff]

[commits ($range) — secondary context only, may include reverted work]
$template_params[commits]

[additional-runtime-instructions]
$additional_runtime_instructions"
#[⫶] fill template


#[…] claude invocation
export ANTHROPIC_MODEL=opus

schema='{
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" }
  },
  "required": ["title", "description"],
  "additionalProperties": false
}'

print -r -- "$prompt" | s-ko-llm-claude "$schema"
#[⫶] claude invocation
#[⫶] 🤖🤖
