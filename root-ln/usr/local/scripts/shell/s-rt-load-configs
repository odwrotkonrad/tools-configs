#!/bin/zsh
#>[≟]
#   Load <configs> into the system root, mirroring directory structure.
#   <configs>/root-ln files are symlinked (live, follow the repo).
#   <configs>/root-cp files are copied as root
#/[≟]

set -e

configs=${1:-/Users/ko/projects/configs}

#[…] symlinked tree
pushd "$configs/root-ln"
find * -type d -exec mkdir -p /{} \;
find * -type f -exec ln -fvws "$PWD"/{} /{} \;
popd
#[⫶] symlinked tree

#[…] 🤖🤖 user owns dirs the root run created
if [[ -n $SUDO_USER ]] {
  user_home=$(dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory | cut -d' ' -f2)
  user_group=$(id -gn "$SUDO_USER")
  [[ -d $user_home ]] && chown -R "$SUDO_USER:$user_group" "$user_home"/.config(N) "$user_home"/.ssh(N) "$user_home"/.ollama(N)
  chown "$SUDO_USER:$user_group" /etc/zsh/zshrc.d/completions
}
#[⫶] user-owned dirs

#[…] copied tree
pushd "$configs/root-cp"
find * -type d -exec mkdir -p /{} \;
find * -type f | while read -r f; do
  sudo install -v -o root -g wheel -m "$(stat -f %Lp "$f")" "$f" "/$f"
done
popd
#[⫶] copied tree
