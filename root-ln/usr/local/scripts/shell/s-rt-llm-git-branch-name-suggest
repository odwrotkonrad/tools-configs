#!/usr/bin/env zsh
#>[≟]
#   LLM driven branch name generation
#   Usage: <extra-instructions-on-stdin> | s-rt-llm-git-branch-name-suggest [range] [include-unstaged=1] [template-file]
#   include-unstaged: 1 add tracked unstaged changes, 0 staged only. Never untracked.
#   extra-instructions: optional, read from stdin when piped.
#   template-file: optional, defaults to ./templates-llm/git-branch-name-suggest.tmpl.md
#   Upstream: git-commit, git-mr skills. Downstream: git subjects + diffs.
#   Out: { "name": ... }.
#/[≟]

set -e


#[…] script input
typeset -A script_input=(
  instructions_runtime "$([[ -t 0 ]] || cat)"

  range "${1:-main..HEAD}"
  include_unstaged "${2:-1}"
  template_file "${3:-${0:A:h}/templates-llm/git-branch-name-suggest.tmpl.md}"
)
#[⫶] script input


#[…] template input 🤖
get_diff_ref() { [[ $script_input[include_unstaged] == 1 ]] && echo HEAD || echo --cached }
get_current_branch() { local b=$(git rev-parse --abbrev-ref HEAD); [[ $b == main ]] || echo $b }
get_commits_log_short() { git log --reverse --format='%s' "$script_input[range]" }
get_commit_template() {
  local f=$(git config --get commit.template); f=${f/#\~/$HOME}
  [[ -n $f && -f $f ]] && cat "$f"
}

typeset -A template_input=(
  CURRENT_BRANCH "$(get_current_branch)"
  COMMIT_TEMPLATE "$(get_commit_template)"
  CHANGES "$(git diff $(get_diff_ref))"
  CHANGES_STATS "$(git diff --stat $(get_diff_ref))"
  COMMITS_LOG_SHORT "$(get_commits_log_short)"
  INSTRUCTIONS_RUNTIME "$script_input[instructions_runtime]"
)
#[⫶] template input 🤖

#[≟] skip llm if there is no diff
if [[ -z $template_input[COMMITS_LOG_SHORT] && -z $template_input[CHANGES] ]]; then
  jq -nc --arg n "tmp/scratch-$(date +%Y%m%d-%H%M%S)" '{name:$n}'
  exit 0
fi


#[…] fill template 🤖
prompt=$(
  for k v in "${(@kv)template_input}"; do export "$k"="$v"; done
  gomplate \
    --plugin stripmd="${0:A:h}/s-rt-read-markdown" \
    -f "$script_input[template_file]"
)
#[⫶] fill template 🤖


#[…] claude invocation
export ANTHROPIC_MODEL=haiku

schema='{
  "type": "object",
  "properties": {
    "name": { "type": "string" }
  },
  "required": ["name"],
  "additionalProperties": false
}'

<<< "$prompt" s-rt-llm-claude "$schema"
#[⫶] claude invocation
