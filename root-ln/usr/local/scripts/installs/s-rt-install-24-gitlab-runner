#!/bin/zsh
#[……] 🤖🤖🤖

emulate -LR zsh
setopt errexit pipefail

autoload -Uz log-msg

#[……] retire brew gitlab-runner service
#>[≟]
#   retire brew's gitlab-runner service so our repo-owned
#   d-ko-gitlab-runner.plist supervises the runner instead
#/[≟]

uid=$(id -u)
brew_plist="$HOME/Library/LaunchAgents/homebrew.mxcl.gitlab-runner.plist"

if brew services list | grep -qE '^gitlab-runner[[:space:]]+(started|loaded|scheduled)'; then
  log-msg -t gitlab-runner -- "stopping brew service"
  brew services stop gitlab-runner
else
  log-msg -t gitlab-runner -- "brew service not running, skipping stop"
fi

if [[ -e $brew_plist ]] {
  log-msg -t gitlab-runner -- "removing stale brew plist"
  launchctl bootout "gui/$uid/homebrew.mxcl.gitlab-runner" 2>/dev/null || true
  rm -f "$brew_plist"
} else {
  log-msg -t gitlab-runner -- "no stale brew plist, skipping bootout"
}
#[⫶⫶] retire brew gitlab-runner service 🤖🤖🤖
