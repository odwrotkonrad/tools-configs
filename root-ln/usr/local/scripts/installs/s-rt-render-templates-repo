#!/bin/zsh
#>[≟] 🤖🤖
#   render every *.repo.auto.tmpl in the configs repo to its stripped
#   sibling in place; secrets resolved from 1Password via the op plugin.
#   run as the user owning the op session.
#   $1 - configs repo path (default: /Users/ko/projects/configs)
#/[≟] 🤖🤖

emulate -LR zsh
set -e

if (( ! $+commands[gomplate] )) exit-with 1 "gomplate not found"
if (( ! $+commands[op] )) exit-with 1 "op (1Password CLI) not found"

#[…] 🤖🤖
configs=${1:-/Users/ko/projects/configs}
[[ -d $configs ]] || exit-with 1 "configs not found: $configs"

for src in $configs/**/*.repo.auto.tmpl(.DN); do
  dst=${src%.repo.auto.tmpl}
  gomplate -f "$src" -o "$dst"
  print "${0:t}: rendered $dst"
done
#[⫶] 🤖🤖
