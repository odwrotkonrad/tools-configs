set virtualedit=onemore

"#[what] Enable mouse support
set mouse=a

"#[what] Yank/paste use the system clipboard by default
set clipboard=unnamedplus

"#[what] Show line numbers
set number

"#[what] Keep up to 1000 levels of undo
set undolevels=1000

"#[what] A tab counts as 2 columns wide
set tabstop=2

"#[what] Auto-wrap inserted text
set textwidth=100

"#[what] Remember up to 1000 lines of command/search history
set history=1000

"#[what] toggle line wrap
set wrap

"#[what] line wrap on word boundaries
set linebreak

"#[what] highlight all matches when searching
set hls

"#[what] ignore case when searching
set ic

"#[what] persistent undo — undo history is saved to disk and survives
set undofile

"#[what] undo files location
set undodir=$XDG_STATE_HOME/vim/undo//


"#[what] <sfile>:h - directory of this vimrc; sources keybindings.vim
source <sfile>:h/keybindings.vim
