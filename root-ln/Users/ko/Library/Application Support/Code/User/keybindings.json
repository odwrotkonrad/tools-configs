[
  //>[what] layout
  // sidebar left: file explorer | sidebar right: scm, extensions | panel top: search | editor area: terminals, search editor, editors
  // keyboard: alt placed directly left of space (macos external QWERTY, no remaps)
  ///[what]
  ///[>] cursor / selection
  {
    "key": "pageup",
    "command": "cursorTop",
    "when": "textInputFocus"
  },
  {
    "key": "pagedown",
    "command": "cursorBottom",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+up",
    "command": "cursorMove",
    "args": {
      "to": "up",
      "by": "line",
      "value": 12
    },
    "when": "textInputFocus"
  },
  {
    "key": "cmd+down",
    "command": "cursorMove",
    "args": {
      "to": "down",
      "by": "line",
      "value": 12
    },
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+up",
    "command": "cursorMove",
    "args": {
      "to": "up",
      "by": "line",
      "value": 3,
      "select": true
    },
    "when": "textInputFocus"
  },
  {
    "key": "shift+cmd+down",
    "command": "cursorMove",
    "args": {
      "to": "down",
      "by": "line",
      "value": 3,
      "select": true
    },
    "when": "textInputFocus"
  },
  ///[<] cursor / selection
  ///[>] editor
  //[what] alt+esc | alt+q — close editor then focus first group (avoids landing in terminal group)
  {
    "key": "alt+escape",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeActiveEditor",
        "workbench.action.focusFirstEditorGroup"
      ]
    },
    "when": "editorFocus && !view.workbench.view.search.visible"
  },
  {
    "key": "alt+q",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeActiveEditor",
        "workbench.action.focusFirstEditorGroup"
      ]
    },
    "when": "editorFocus && !view.workbench.view.search.visible"
  },
  {
    "key": "alt+r",
    "command": "workbench.action.reopenClosedEditor",
    "when": "!findWidgetVisible"
  },
  //[what] alt+tab — cycle tabs within the group
  {
    "key": "alt+tab",
    "command": "workbench.action.nextEditorInGroup",
    "when": "activeEditor"
  },
  //[what] alt+1/2 — focus first/second group
  {
    "key": "alt+1",
    "command": "workbench.action.focusFirstEditorGroup"
  },
  {
    "key": "alt+2",
    "command": "workbench.action.focusSecondEditorGroup"
  },
  {
    "key": "alt+down",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+up",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+f",
    "command": "actions.find",
    "when": "editorFocus"
  },
  {
    "key": "alt+r",
    "command": "editor.action.startFindReplaceAction",
    "when": "findWidgetVisible && findInputFocussed"
  },
  //[what] alt+] — format selection or document
  {
    "key": "alt+]",
    "command": "editor.action.formatDocument",
    "when": "editorTextFocus && !editorHasSelection && !editorReadonly"
  },
  {
    "key": "alt+]",
    "command": "editor.action.formatSelection",
    "when": "editorTextFocus && editorHasSelection && !editorReadonly"
  },
  {
    "key": "alt+\\",
    "command": "editor.action.toggleWordWrap"
  },
  //[what] alt+shift+l — advanced editing mode: cycle line numbers + folding on/off 🤖🤖
  {
    "key": "alt+shift+l",
    "command": "settings.cycle",
    "args": {
      "id": "advanced-editing-mode",
      "values": [
        {
          "editor.lineNumbers": "off",
          "editor.folding": false,
          "editor.stickyScroll.enabled": false
        },
        {
          "editor.lineNumbers": "on",
          "editor.folding": true,
          "editor.stickyScroll.enabled": true
        }
      ]
    }
  },
  {
    "key": "alt+m",
    "command": "workbench.action.toggleMaximizeEditorGroup"
  },
  {
    "key": "alt+b",
    "command": "workbench.action.evenEditorWidths"
  },
  //[what] alt+ctrl+arrow — spatial nav across groups & parts (grid-aware)
  {
    "key": "alt+ctrl+left",
    "command": "workbench.action.navigateLeft"
  },
  {
    "key": "alt+ctrl+right",
    "command": "workbench.action.navigateRight"
  },
  {
    "key": "alt+ctrl+up",
    "command": "workbench.action.navigateUp"
  },
  {
    "key": "alt+ctrl+down",
    "command": "workbench.action.navigateDown"
  },
  //[what] alt+ctrl+up/down — cycle SCM aux-bar views: Changes ⇄ Graph ⇄ Timeline
  {
    "key": "alt+ctrl+down",
    "command": "workbench.scm.history.focus",
    "when": "auxiliaryBarFocus && focusedView == 'workbench.scm'"
  },
  {
    "key": "alt+ctrl+down",
    "command": "timeline.focus",
    "when": "auxiliaryBarFocus && focusedView == 'workbench.scm.history'"
  },
  {
    "key": "alt+ctrl+up",
    "command": "workbench.scm.history.focus",
    "when": "auxiliaryBarFocus && focusedView == 'timeline'"
  },
  {
    "key": "alt+ctrl+up",
    "command": "workbench.scm.focus",
    "when": "auxiliaryBarFocus && focusedView == 'workbench.scm.history'"
  },
  //[what] alt+ctrl+up/down — cycle side-bar views: Explorer ⇄ Outline
  {
    "key": "alt+ctrl+down",
    "command": "outline.focus",
    "when": "sideBarFocus && focusedView == 'workbench.explorer.fileView'"
  },
  {
    "key": "alt+ctrl+up",
    "command": "workbench.explorer.fileView.focus",
    "when": "sideBarFocus && focusedView == 'outline'"
  },
  //[what] alt+l — toggle command palette
  {
    "key": "alt+l",
    "command": "workbench.action.showCommands",
    "when": "!inQuickOpen"
  },
  {
    "key": "alt+l",
    "command": "workbench.action.closeQuickOpen",
    "when": "inQuickOpen"
  },
  //[what] f2 — rename currently opened file
  {
    "key": "f2",
    "command": "runCommands",
    "args": {
      "commands": [
        "revealInExplorer",
        "renameFile"
      ]
    },
    "when": "editorFocus"
  },
  //[what] esc — unmaximize maximized editor group (regular editors)
  {
    "key": "escape",
    "command": "workbench.action.toggleMaximizeEditorGroup",
    "when": "editorPartMaximizedEditorGroup && editorTextFocus && !textCompareEditorActive && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !renameInputVisible && !parameterHintsVisible"
  },
  //[what] esc on diff — close diff; if maximized, also unmaximize
  {
    "key": "escape",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeActiveEditor",
        "workbench.action.toggleMaximizeEditorGroup"
      ]
    },
    "when": "textCompareEditorActive && editorPartMaximizedEditorGroup"
  },
  {
    "key": "escape",
    "command": "workbench.action.closeActiveEditor",
    "when": "textCompareEditorActive && !editorPartMaximizedEditorGroup"
  },
  //[what] alt+esc | alt+q on diff — close diff; if maximized, also unmaximize
  {
    "key": "alt+escape",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeActiveEditor",
        "workbench.action.toggleMaximizeEditorGroup"
      ]
    },
    "when": "textCompareEditorActive && editorPartMaximizedEditorGroup"
  },
  {
    "key": "alt+q",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.closeActiveEditor",
        "workbench.action.toggleMaximizeEditorGroup"
      ]
    },
    "when": "textCompareEditorActive && editorPartMaximizedEditorGroup"
  },
  {
    "key": "alt+escape",
    "command": "workbench.action.closeActiveEditor",
    "when": "textCompareEditorActive && !editorPartMaximizedEditorGroup"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closeActiveEditor",
    "when": "textCompareEditorActive && !editorPartMaximizedEditorGroup"
  },
  //[what] esc — in the git commit message editor: closes
  {
    "key": "escape",
    "command": "git.commitMessageDiscard",
    "when": "editorTextFocus && editorLangId == 'git-commit'"
  },
  ///[<] editor
  ///[>] search
  //[what] alt+w — toggle quick text search
  {
    "key": "alt+w",
    "command": "workbench.action.quickTextSearch",
    "when": "!inQuickOpen"
  },
  {
    "key": "alt+w",
    "command": "workbench.action.closeQuickOpen",
    "when": "inQuickOpen"
  },
  //[what] alt+x — toggle quick file open
  {
    "key": "alt+x",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "alt+x",
    "command": "workbench.action.closeQuickOpen",
    "when": "inQuickOpen"
  },
  //[what] alt+s — toggle search panel
  {
    "key": "alt+s",
    "command": "workbench.action.findInFiles",
    "when": "!searchViewletVisible"
  },
  {
    "key": "alt+s",
    "command": "workbench.action.closePanel",
    "when": "searchViewletVisible"
  },
  //[what] alt+g — search view → editor / elsewhere → new search editor in first group / inside search editor → close
  {
    "key": "alt+g",
    "command": "runCommands",
    "args": {
      "commands": [
        "search.action.openInEditor",
        "workbench.action.closePanel"
      ]
    },
    "when": "searchViewletFocus"
  },
  {
    "key": "alt+g",
    "command": "runCommands",
    "args": {
      "commands": [
        "search.action.openNewEditor",
        "workbench.action.moveEditorToFirstGroup",
        "workbench.action.closePanel"
      ]
    },
    "when": "!inSearchEditor && !searchViewletFocus"
  },
  {
    "key": "alt+g",
    "command": "workbench.action.closeActiveEditor",
    "when": "inSearchEditor"
  },
  {
    "key": "alt+r",
    "command": "workbench.action.replaceInFiles",
    "when": "searchViewletFocus"
  },
  //[what] alt+esc | alt+q — search editor: close (no prompt) / panel: close preview then panel
  {
    "key": "alt+escape",
    "command": "workbench.action.revertAndCloseActiveEditor",
    "when": "inSearchEditor"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.revertAndCloseActiveEditor",
    "when": "inSearchEditor"
  },
  {
    "key": "alt+escape",
    "command": "workbench.action.closeActiveEditor",
    "when": "searchViewletFocus && activeEditorIsPreview"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closeActiveEditor",
    "when": "searchViewletFocus && activeEditorIsPreview"
  },
  {
    "key": "alt+escape",
    "command": "workbench.action.closePanel",
    "when": "searchViewletFocus && !activeEditorIsPreview"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closePanel",
    "when": "searchViewletFocus && !activeEditorIsPreview"
  },
  {
    "key": "alt+escape",
    "command": "workbench.action.closePanel",
    "when": "editorFocus && view.workbench.view.search.visible"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closePanel",
    "when": "editorFocus && view.workbench.view.search.visible"
  },
  //[what] enter — input → re-run search, keep focus in input (down enters results) / result → open in second group
  {
    "key": "enter",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusSecondEditorGroup",
        "search.action.focusSearchList",
        "list.select"
      ]
    },
    "when": "searchViewletFocus && !inputBoxFocus"
  },
  //[what] down — search input → enter results (only if any; state is settled by now)
  {
    "key": "down",
    "command": "search.action.focusSearchList",
    "when": "searchViewletFocus && inputBoxFocus && hasSearchResult"
  },
  //[what] up/down on search result — focus group 2 first so preview lands there
  {
    "key": "down",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusSecondEditorGroup",
        "search.action.focusSearchList",
        "list.focusDown"
      ]
    },
    "when": "searchViewletFocus && !inputBoxFocus"
  },
  {
    "key": "up",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusSecondEditorGroup",
        "search.action.focusSearchList",
        "list.focusUp"
      ]
    },
    "when": "searchViewletFocus && !inputBoxFocus"
  },
  //[what] esc — search input (not search-editor): focus editor / search view: results→input, input→first group
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "searchInputBoxFocus && !inSearchEditor"
  },
  {
    "key": "escape",
    "command": "workbench.action.findInFiles",
    "when": "searchViewletFocus && !inputBoxFocus"
  },
  {
    "key": "escape",
    "command": "workbench.action.focusFirstEditorGroup",
    "when": "searchViewletFocus && inputBoxFocus"
  },
  //[what] esc — search editor: close (no save prompt), like alt+esc
  {
    "key": "escape",
    "command": "workbench.action.revertAndCloseActiveEditor",
    "when": "inSearchEditor"
  },
  //[what] esc from editor — priority: 1) search panel → results if any, else input; 2) sidebar → reveal in explorer; 3) → focus first group
  {
    "key": "escape",
    "command": "search.action.focusSearchList",
    "when": "view.workbench.view.search.visible && hasSearchResult && editorTextFocus && !textCompareEditorActive && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !renameInputVisible && !parameterHintsVisible"
  },
  {
    "key": "escape",
    "command": "workbench.action.findInFiles",
    "when": "view.workbench.view.search.visible && !hasSearchResult && editorTextFocus && !textCompareEditorActive && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !renameInputVisible && !parameterHintsVisible"
  },
  {
    "key": "escape",
    "command": "workbench.action.focusFirstEditorGroup",
    "when": "editorTextFocus && editorLangId != 'git-commit' && !textCompareEditorActive && !view.workbench.view.search.visible && !sideBarVisible && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !renameInputVisible && !parameterHintsVisible"
  },
  ///[<] search
  ///[>] terminal
  //>[what] alt+t
  //  no terminal: create in last editor group
  //  terminal exists: focus (move from panel to editor)
  //  on terminal alone in group: spawn another terminal in this group
  //  on terminal sharing group: move to next editor in group
  ///[what]
  {
    "key": "alt+t",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusLastEditorGroup",
        "workbench.action.createTerminalEditor"
      ]
    },
    "when": "!terminalIsOpen"
  },
  {
    "key": "alt+t",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.focusLastEditorGroup",
        "workbench.action.terminal.focus",
        "workbench.action.terminal.moveToEditor"
      ]
    },
    "when": "terminalIsOpen && !terminalFocus"
  },
  {
    "key": "alt+t",
    "command": "workbench.action.createTerminalEditorSameGroup",
    "when": "terminalFocus && terminalEditorFocus && groupEditorsCount == 1"
  },
  {
    "key": "alt+t",
    "command": "workbench.action.nextEditorInGroup",
    "when": "terminalFocus && terminalEditorFocus && groupEditorsCount > 1"
  },
  {
    "key": "alt+f",
    "command": "workbench.action.terminal.focusFind",
    "when": "terminalFocus"
  },
  //[what] alt+ctrl+t — new terminal in the currently focused editor group
  {
    "key": "alt+ctrl+t",
    "command": "workbench.action.createTerminalEditor"
  },
  //[what] alt+esc | alt+q — terminal editor: close it; panel terminal: focus next group
  {
    "key": "alt+escape",
    "command": "workbench.action.terminal.killEditor",
    "when": "terminalFocus && terminalEditorFocus"
  },
  {
    "key": "alt+escape",
    "command": "workbench.action.focusNextGroup",
    "when": "terminalFocus && !terminalEditorFocus"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.terminal.killEditor",
    "when": "terminalFocus && terminalEditorFocus"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.focusNextGroup",
    "when": "terminalFocus && !terminalEditorFocus"
  },
  {
    "key": "alt+shift+t",
    "command": "workbench.action.terminal.openNativeConsole"
  },
  ///[<] terminal
  ///[>] file explorer
  //[what] alt+a — toggle explorer
  {
    "key": "alt+a",
    "command": "workbench.view.explorer",
    "when": "!sideBarVisible || activeViewlet != 'workbench.view.explorer'"
  },
  {
    "key": "alt+a",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "sideBarVisible && activeViewlet == 'workbench.view.explorer'"
  },
  //[what] esc from editor — reveal current file in explorer (when visible, no search)
  {
    "key": "escape",
    "command": "revealInExplorer",
    "when": "editorTextFocus && sideBarVisible && !textCompareEditorActive && !view.workbench.view.search.visible && !suggestWidgetVisible && !findWidgetVisible && !inSnippetMode && !renameInputVisible && !parameterHintsVisible"
  },
  //[what] enter — open file / toggle folder
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsFolder"
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && !inputFocus && explorerResourceIsFolder"
  },
  //[what] alt+up / alt+down — jump 3 entries
  {
    "key": "alt+up",
    "command": "runCommands",
    "args": {
      "commands": [
        "list.focusUp",
        "list.focusUp",
        "list.focusUp"
      ]
    },
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "alt+down",
    "command": "runCommands",
    "args": {
      "commands": [
        "list.focusDown",
        "list.focusDown",
        "list.focusDown"
      ]
    },
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "f2",
    "command": "renameFile",
    "when": "filesExplorerFocus && !inputFocus"
  },
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "filesExplorerFocus && !inputFocus"
  },
  ///[<] file explorer
  ///[>] output
  //[what] alt+esc | alt+q | esc — output focused: close panel
  {
    "key": "alt+escape",
    "command": "workbench.action.closePanel",
    "when": "focusedView == 'workbench.panel.output'"
  },
  {
    "key": "alt+q",
    "command": "workbench.action.closePanel",
    "when": "focusedView == 'workbench.panel.output'"
  },
  {
    "key": "escape",
    "command": "workbench.action.closePanel",
    "when": "focusedView == 'workbench.panel.output'"
  },
  ///[<] output
  ///[>] source control
  //[what] alt+c — toggle SCM aux bar
  {
    "key": "alt+c",
    "command": "workbench.view.scm",
    "when": "activeAuxiliary != 'workbench.view.scm'"
  },
  {
    "key": "alt+c",
    "command": "workbench.action.closeAuxiliaryBar",
    "when": "activeAuxiliary == 'workbench.view.scm'"
  },
  //[what] alt+d — toggle SCM Graph panel
  {
    "key": "alt+d",
    "command": "workbench.scm.history.focus",
    "when": "focusedView != 'workbench.scm.history'"
  },
  {
    "key": "alt+d",
    "command": "workbench.action.closePanel",
    "when": "focusedView == 'workbench.scm.history'"
  },
  //[what] alt+/ — commit / alt+shift+/ — amend; from the SCM view or an editor
  {
    "key": "alt+/",
    "command": "git.commit",
    "when": "scmRepository || focusedView == 'workbench.scm' || editorTextFocus"
  },
  {
    "key": "alt+shift+/",
    "command": "git.commitAmend",
    "when": "scmRepository || focusedView == 'workbench.scm' || editorTextFocus"
  },
  //[what] alt+m — in the SCM message input: generate the commit message
  {
    "key": "alt+m",
    "command": "github.copilot.git.generateCommitMessage",
    "when": "scmRepository"
  },
  //[what] alt+p — push
  {
    "key": "alt+p",
    "command": "git.push",
    "when": "focusedView == 'workbench.scm' || editorTextFocus || terminalFocus"
  },
  //[what] alt+shift+p — force push (--force-with-lease, no pull)
  {
    "key": "alt+shift+p",
    "command": "git.pushForce",
    "when": "focusedView == 'workbench.scm' || editorTextFocus || terminalFocus"
  },
  //[what] down — from last line of SCM message box, focus the changes list
  {
    "key": "down",
    "command": "runCommands",
    "args": {
      "commands": [
        "list.focusFirst",
        "list.focusDown",
        "list.focusDown"
      ]
    },
    "when": "scmInputIsInLastPosition && scmRepository && !suggestWidgetVisible"
  },
  //[what] esc — on a changes item: focus the SCM message input
  {
    "key": "escape",
    "command": "workbench.scm.action.focusPreviousInput",
    "when": "focusedView == 'workbench.scm'"
  },
  //[what] esc — in the SCM message input: focus the active editor
  {
    "key": "escape",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "scmRepository"
  },
  //[what] esc — from another auxiliary-bar view: focus the SCM view then its message input
  {
    "key": "escape",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.view.scm",
        "workbench.scm.action.focusPreviousInput"
      ]
    },
    "when": "auxiliaryBarFocus && !scmRepository && focusedView != 'workbench.scm'"
  },
  ///[<] source control
  ///[>] font zoom — terminal in terminal focus, editor elsewhere
  {
    "key": "alt+.",
    "command": "workbench.action.terminal.fontZoomIn",
    "when": "terminalFocus"
  },
  {
    "key": "alt+,",
    "command": "workbench.action.terminal.fontZoomOut",
    "when": "terminalFocus"
  },
  {
    "key": "alt+0",
    "command": "workbench.action.terminal.fontZoomReset",
    "when": "terminalFocus"
  },
  {
    "key": "alt+.",
    "command": "editor.action.fontZoomIn",
    "when": "!terminalFocus"
  },
  {
    "key": "alt+,",
    "command": "editor.action.fontZoomOut",
    "when": "!terminalFocus"
  },
  {
    "key": "alt+0",
    "command": "editor.action.fontZoomReset",
    "when": "!terminalFocus"
  },
  {
    "key": "cmd+0",
    "command": "workbench.action.zoomReset"
  },
  ///[<] font zoom — terminal in terminal focus, editor elsewhere
  ///[>] default unbinds
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeActiveEditor"
  },
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeGroup",
    "when": "activeEditorGroupEmpty && multipleEditorGroups"
  },
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeWindow",
    "when": "!editorIsOpen && !multipleEditorGroups"
  },
  {
    "key": "cmd+w",
    "command": "-workbench.action.terminal.killEditor",
    "when": "terminalEditorFocus && terminalFocus && terminalHasBeenCreated || terminalEditorFocus && terminalFocus && terminalProcessSupported"
  },
  {
    "key": "shift+cmd+w",
    "command": "-workbench.action.closeWindow"
  },
  {
    "key": "cmd+q",
    "command": "-workbench.action.quit"
  },
