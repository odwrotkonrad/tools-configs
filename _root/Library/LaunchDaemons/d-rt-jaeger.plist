<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>d-rt-jaeger</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/jaeger</string>
		<string>--config=file:/etc/jaeger/config.yml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/jaeger/jaeger.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/jaeger/jaeger.log</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
