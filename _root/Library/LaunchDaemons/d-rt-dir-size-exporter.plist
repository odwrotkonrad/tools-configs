<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>d-rt-dir-size-exporter</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/scripts/shell/s-rt-export-dir-sizes</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/dir_size_exporter/dir_size_exporter.log</string>
	<key>StandardOutPath</key>
	<string>/var/log/dir_size_exporter/dir_size_exporter.log</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
