# DESCRIPTION
#   install config files by creating hard links of all leaf config files, creating dirs on the fly
#   files not tracked by dotfiles are not touched
emulate -L zsh

typeset -A links=(
  _home      ~
  _xdg/bin   ${XDG_BIN_HOME}
  _etc       /etc
  _usr       /usr
)

for src target in "${(@kv)links}"; do
  sudo=
  [[ -w $target ]] || sudo=sudo

  # -R - entire subtree
  # -s - create symbolic links
  # -f - if file exists, override
  # -v - verbose, prints linked files
  $sudo cp -Rsfv ~dotfiles/$src/. $target/
done
